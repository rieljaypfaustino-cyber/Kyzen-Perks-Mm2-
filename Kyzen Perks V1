--====================================================--
-- FIND DROPPED GUN
--====================================================--

local function isGunObject(object)
	if not object then
		return false
	end

	if object:IsA("Tool") then
		return looksLikeGun(object.Name)
	end

	return looksLikeGun(object.Name)
end

local function findDroppedGun()
	local closest = nil
	local closestDistance = math.huge

	local localRoot = getRoot(LocalPlayer.Character)

	if not localRoot then
		return nil
	end

	for _, object in ipairs(Workspace:GetDescendants()) do

		if object:IsA("Tool") and isGunObject(object) then

			-- Ignore guns currently inside a player's character/backpack
			local parent = object.Parent

			local insidePlayer = false

			for _, player in ipairs(Players:GetPlayers()) do
				if player.Character == parent
					or player:FindFirstChildOfClass("Backpack") == parent then

					insidePlayer = true
					break
				end
			end

			if not insidePlayer then

				local handle =
					object:FindFirstChild("Handle")
					or object:FindFirstChildWhichIsA("BasePart", true)

				if handle and handle:IsA("BasePart") then
					local distance =
						(localRoot.Position - handle.Position).Magnitude

					if distance < closestDistance
						and distance <= CONFIG.AutoPickDistance then

						closestDistance = distance
						closest = handle
					end
				end
			end
		end
	end

	-- Also support dropped gun models
	for _, object in ipairs(Workspace:GetChildren()) do

		if object:IsA("Model") and isGunObject(object) then

			local handle =
				object:FindFirstChild("Handle")
				or object.PrimaryPart
				or object:FindFirstChildWhichIsA("BasePart", true)

			if handle and handle:IsA("BasePart") then

				local distance =
					(localRoot.Position - handle.Position).Magnitude

				if distance < closestDistance
					and distance <= CONFIG.AutoPickDistance then

					closestDistance = distance
					closest = handle
				end
			end
		end
	end

	return closest
end

--====================================================--
-- AUTO PICK GUN
--====================================================--

local function autoPickGun()
	if AutoPickBusy then
		return
	end

	if not CONFIG.AutoPickGun then
		return
	end

	local character = LocalPlayer.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local root = getRoot(character)

	if not humanoid or not root or humanoid.Health <= 0 then
		return
	end

	local gunHandle = findDroppedGun()

	if not gunHandle then
		FarmStatus.Text = "Status: No dropped gun detected."
		return
	end

	AutoPickBusy = true

	FarmStatus.Text = "Status: Dropped gun detected. Moving to gun..."

	local targetPosition = gunHandle.Position

	-- Legitimate movement toward the gun.
	-- The game's own Touched pickup system should
	-- give the gun when the character physically reaches it.

	humanoid:MoveTo(targetPosition)

	local startTime = os.clock()

	while
		CONFIG.AutoPickGun
		and humanoid.Health > 0
		and gunHandle
		and gunHandle.Parent
		and os.clock() - startTime < CONFIG.AutoPickMoveTimeout
	do

		local currentRoot = getRoot(character)

		if not currentRoot then
			break
		end

		local distance =
			(currentRoot.Position - gunHandle.Position).Magnitude

		if distance <= 5 then
			FarmStatus.Text = "Status: Reached dropped gun."

			task.wait(0.4)

			-- Check if the game's real pickup system
			-- already gave us the gun.
			local tool = findTool(LocalPlayer)

			if tool and looksLikeGun(tool.Name) then
				FarmStatus.Text = "Status: Gun picked up successfully."
			else
				FarmStatus.Text =
					"Status: At gun. Waiting for game's touch pickup..."
			end

			break
		end

		task.wait(0.1)
	end

	AutoPickBusy = false
end


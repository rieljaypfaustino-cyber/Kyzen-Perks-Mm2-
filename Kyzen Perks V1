--====================================================--
-- HELPERS
--====================================================--

local function isAlive(character)
	if not character then
		return false
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	return humanoid and humanoid.Health > 0
end

local function getRoot(character)
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")
end

local function lower(str)
	return string.lower(tostring(str or ""))
end

local function looksLikeKnife(name)
	name = lower(name)

	return
		string.find(name, "knife", 1, true)
		or string.find(name, "blade", 1, true)
		or string.find(name, "dagger", 1, true)
		or string.find(name, "murder", 1, true)
end

local function looksLikeGun(name)
	name = lower(name)

	return
		string.find(name, "gun", 1, true)
		or string.find(name, "pistol", 1, true)
		or string.find(name, "revolver", 1, true)
		or string.find(name, "revolver", 1, true)
		or string.find(name, "sheriff", 1, true)
		or string.find(name, "weapon", 1, true)
end

--====================================================--
-- ROLE DETECTION
--====================================================--

local function getAttributeRole(player)
	local possibleNames = {
		"Role",
		"role",
		"PlayerRole",
		"CurrentRole",
		"GameRole",
	}

	for _, attributeName in ipairs(possibleNames) do
		local value = player:GetAttribute(attributeName)

		if typeof(value) == "string" then
			local role = value

			if ROLE_COLORS[role] then
				return role
			end

			local formatted = string.sub(role, 1, 1):upper()
				.. string.sub(role, 2):lower()

			if ROLE_COLORS[formatted] then
				return formatted
			end
		end
	end

	return nil
end

local function findTool(player)
	local character = player.Character

	if character then
		for _, object in ipairs(character:GetChildren()) do
			if object:IsA("Tool") then
				return object
			end
		end
	end

	local backpack = player:FindFirstChildOfClass("Backpack")

	if backpack then
		for _, object in ipairs(backpack:GetChildren()) do
			if object:IsA("Tool") then
				return object
			end
		end
	end

	return nil
end

local function detectRole(player)
	--================================================--
	-- 1. USE GAME ATTRIBUTE FIRST
	--================================================--

	local attributeRole = getAttributeRole(player)

	if attributeRole then
		LastKnownRole[player] = attributeRole

		if attributeRole == "Sheriff" then
			SheriffPlayer = player
		end

		return attributeRole
	end

	--================================================--
	-- 2. TOOL DETECTION
	--================================================--

	local tool = findTool(player)

	if tool then
		if looksLikeKnife(tool.Name) then
			LastKnownRole[player] = "Murderer"
			return "Murderer"
		end

		if looksLikeGun(tool.Name) then

			-- If this player was previously Innocent
			-- and the Sheriff is already dead,
			-- treat the gun holder as Hero.
			if LastKnownRole[player] == "Innocent"
				and SheriffPlayer
				and not isAlive(SheriffPlayer.Character)
			then
				CurrentHero = player
				LastKnownRole[player] = "Hero"

				return "Hero"
			end

			LastKnownRole[player] = "Sheriff"
			SheriffPlayer = player

			return "Sheriff"
		end
	end

	--================================================--
	-- 3. KEEP HERO STATE
	--================================================--

	if LastKnownRole[player] == "Hero" then
		return "Hero"
	end

	--================================================--
	-- 4. DEFAULT
	--================================================--

	if not LastKnownRole[player] then
		LastKnownRole[player] = "Innocent"
	end

	return LastKnownRole[player]
end


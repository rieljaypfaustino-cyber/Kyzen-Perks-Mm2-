-- PLAYER CONNECTIONS
--====================================================--

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	LastKnownRole[player] = nil

	player.CharacterAdded:Connect(function(character)

		-- Wait for the rig to exist
		task.wait(0.4)

		removeESP(player)

		if CONFIG.ESP then
			createESP(player)
		end
	end)

	player.CharacterRemoving:Connect(function()
		-- Remove old highlight/billboard.
		-- It will automatically be recreated on CharacterAdded.
		removeESP(player)
	end)

	player:GetAttributeChangedSignal("Role"):Connect(function()
		task.wait(0.1)
		updateESP(player)
	end)

	player:GetAttributeChangedSignal("role"):Connect(function()
		task.wait(0.1)
		updateESP(player)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayer(player)
end

Players.PlayerAdded:Connect(function(player)
	setupPlayer(player)
end)

Players.PlayerRemoving:Connect(function(player)
	removeESP(player)
	LastKnownRole[player] = nil

	if SheriffPlayer == player then
		SheriffPlayer = nil
	end

	if CurrentHero == player then
		CurrentHero = nil
	end
end)


--====================================================--
-- UTILITY
--====================================================--

local function create(className, properties, parent)

	local object = Instance.new(className)

	for property, value in pairs(properties or {}) do
		pcall(function()
			object[property] = value
		end)
	end

	if parent then
		object.Parent = parent
	end

	return object
end

local function destroy(object)

	if object then
		pcall(function()
			object:Destroy()
		end)
	end
end

local function corner(object, radius)

	local c = Instance.new("UICorner")

	c.CornerRadius = UDim.new(0, radius or 8)

	c.Parent = object

	return c
end

local function stroke(object, color, thickness, transparency)

	local s = Instance.new("UIStroke")

	s.Color = color or COLORS.Black

	s.Thickness = thickness or 1

	s.Transparency = transparency or 0

	s.Parent = object

	return s
end

local function gradient(object, color1, color2, rotation)

	local g = Instance.new("UIGradient")

	g.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color1),
		ColorSequenceKeypoint.new(1, color2),
	})

	g.Rotation = rotation or 90

	g.Parent = object

	return g
end

local function tween(object, properties, time)

	if not object then
		return
	end

	local success, animation = pcall(function()

		return TweenService:Create(
			object,

			TweenInfo.new(
				time or 0.18,
				Enum.EasingStyle.Quart,
				Enum.EasingDirection.Out
			),

			properties
		)

	end)

	if success and animation then
		animation:Play()
	end
end

--====================================================--
-- ROLE NORMALIZATION
--====================================================--

local function normalizeRole(value)

	if typeof(value) ~= "string" then
		return nil
	end

	local role = string.lower(value)

	role = role:gsub("%s+", "")
	role = role:gsub("_", "")
	role = role:gsub("-", "")

	if role == "murderer"
		or role == "murder"
		or role == "killer"
		or role == "mmurderer" then

		return "Murderer"

	elseif role == "sheriff"
		or role == "cop"
		or role == "police" then

		return "Sheriff"

	elseif role == "hero" then

		return "Hero"

	elseif role == "innocent"
		or role == "civilian"
		or role == "citizen"
		or role == "survivor" then

		return "Innocent"
	end

	return nil
end

--====================================================--
-- SERVER ROLE ATTRIBUTES
--====================================================--

local ROLE_ATTRIBUTES = {
	"Role",
	"PlayerRole",
	"CurrentRole",
	"RoleName",
	"GameRole",
	"RoundRole",
	"TeamRole",
	"RoleType",
	"CharacterRole",
}

local function getAttributeRole(player)

	for _, attributeName in ipairs(ROLE_ATTRIBUTES) do

		local value = player:GetAttribute(attributeName)

		local role = normalizeRole(value)

		if role then
			return role
		end
	end

	-- Character attributes.
	local character = player.Character

	if character then

		for _, attributeName in ipairs(ROLE_ATTRIBUTES) do

			local value = character:GetAttribute(attributeName)

			local role = normalizeRole(value)

			if role then
				return role
			end
		end
	end

	return nil
end

--====================================================--
-- TEAM ROLE
--====================================================--

local function getTeamRole(player)

	if not player.Team then
		return nil
	end

	return normalizeRole(player.Team.Name)
end

--====================================================--
-- TOOL DETECTION
--====================================================--

local function getToolRole(tool)

	if not tool then
		return nil
	end

	-- Attributes first.
	for _, attributeName in ipairs(ROLE_ATTRIBUTES) do

		local value = tool:GetAttribute(attributeName)

		local role = normalizeRole(value)

		if role then
			return role
		end
	end

	local name = string.lower(tool.Name or "")

	-- Murderer-specific names.
	if string.find(name, "knife", 1, true)
		or string.find(name, "blade", 1, true)
		or string.find(name, "dagger", 1, true)
		or string.find(name, "murderer", 1, true) then

		return "Murderer"
	end

	-- Sheriff gun names.
	if string.find(name, "sheriff", 1, true)
		or string.find(name, "gun", 1, true)
		or string.find(name, "pistol", 1, true)
		or string.find(name, "revolver", 1, true) then

		return "Sheriff"
	end

	return nil
end

local function getToolRoleFromContainer(container)

	if not container then
		return nil
	end

	for _, child in ipairs(container:GetChildren()) do

		if child:IsA("Tool") then

			local role = getToolRole(child)

			if role then
				return role
			end
		end
	end

	return nil
end

--====================================================--
-- ROUND SHERIFF / HERO TRACKING
--====================================================--

local function registerGunHolder(player)

	if not player then
		return
	end

	if RoundFirstSheriffUserId == nil then

		RoundFirstSheriffUserId = player.UserId

		CurrentGunHolderUserId = player.UserId

		return "Sheriff"
	end

	if RoundFirstSheriffUserId == player.UserId then

		CurrentGunHolderUserId = player.UserId

		return "Sheriff"
	end

	CurrentGunHolderUserId = player.UserId

	return "Hero"
end

--====================================================--
-- ROLE DETECTION
--====================================================--

local function detectRole(player)

	if not player then
		return "Innocent", "Default"
	end

	--================================================--
	-- 1. SERVER ATTRIBUTE
	--================================================--

	local attributeRole = getAttributeRole(player)

	if attributeRole then

		if attributeRole == "Sheriff" then

			if RoundFirstSheriffUserId == nil then
				RoundFirstSheriffUserId = player.UserId
			end

			CurrentGunHolderUserId = player.UserId
		end

		PlayerRoles[player.UserId] = attributeRole

		return attributeRole, "Attribute"
	end

	--================================================--
	-- 2. TEAM
	--================================================--

	local teamRole = getTeamRole(player)

	if teamRole then

		if teamRole == "Sheriff" then

			if RoundFirstSheriffUserId == nil then
				RoundFirstSheriffUserId = player.UserId
			end

			CurrentGunHolderUserId = player.UserId
		end

		PlayerRoles[player.UserId] = teamRole

		return teamRole, "Team"
	end

	--================================================--
	-- 3. CHARACTER TOOL
	--================================================--

	local character = player.Character

	local characterToolRole =
		getToolRoleFromContainer(character)

	if characterToolRole == "Murderer" then

		PlayerRoles[player.UserId] = "Murderer"

		return "Murderer", "Tool"
	end

	if characterToolRole == "Sheriff" then

		local role = registerGunHolder(player)

		PlayerRoles[player.UserId] = role

		return role, "Gun"
	end

	--================================================--
	-- 4. BACKPACK TOOL
	--================================================--

	local backpack =
		player:FindFirstChildOfClass("Backpack")

	local backpackRole =
		getToolRoleFromContainer(backpack)

	if backpackRole == "Murderer" then

		PlayerRoles[player.UserId] = "Murderer"

		return "Murderer", "Backpack"
	end

	if backpackRole == "Sheriff" then

		local role = registerGunHolder(player)

		PlayerRoles[player.UserId] = role

		return role, "BackpackGun"
	end

	--================================================--
	-- 5. KEEP KNOWN ROLE DURING ROUND
	--================================================--

	local knownRole = PlayerRoles[player.UserId]

	if knownRole then

		-- Don't keep a dead role forever.
		if character then

			local humanoid =
				character:FindFirstChildOfClass("Humanoid")

			if humanoid and humanoid.Health > 0 then

				return knownRole, "Known"
			end
		end
	end

	--================================================--
	-- 6. DEFAULT
	--================================================--

	PlayerRoles[player.UserId] = "Innocent"

	return "Innocent", "Default"
end

--====================================================--
-- ROUND DETECTION
--====================================================--

local ROUND_ATTRIBUTES = {
	"RoundId",
	"Round",
	"RoundNumber",
	"GameRound",
	"MatchId",
	"MatchNumber",
	"CurrentRound",
	"RoundState",
	"GameState",
	"Phase",
}

local function findRoundValue(root)

	for _, attributeName in ipairs(ROUND_ATTRIBUTES) do

		local value = root:GetAttribute(attributeName)

		if value ~= nil then

			return attributeName .. ":" .. tostring(value)
		end
	end

	return nil
end

local function getRoundSignature()

	local workspaceRound =
		findRoundValue(Workspace)

	if workspaceRound then
		return "Workspace|" .. workspaceRound
	end

	local replicatedRound =
		findRoundValue(ReplicatedStorage)

	if replicatedRound then
		return "ReplicatedStorage|" .. replicatedRound
	end

	-- Search common replicated values.
	for _, root in ipairs({
		Workspace,
		ReplicatedStorage
	}) do

		for _, object in ipairs(root:GetDescendants()) do

			if object:IsA("StringValue")
				or object:IsA("IntValue")
				or object:IsA("NumberValue") then

				local name =
					string.lower(object.Name)

				if name == "round"
					or name == "roundid"
					or name == "roundnumber"
					or name == "gameround"
					or name == "currentround"
					or name == "roundstate"
					or name == "gamestate"
					or name == "phase" then

					return
						object:GetFullName()
						.. ":"
						.. tostring(object.Value)
				end
			end
		end
	end

	return ""
end

local function resetRound()

	RoundFirstSheriffUserId = nil

	CurrentGunHolderUserId = nil

	LastGunHolderUserId = nil

	LastGunDropCFrame = nil

	table.clear(PlayerRoles)

	-- Completely remove old ESP.
	for player in pairs(ESPObjects) do

		local data = ESPObjects[player]

		if data then

			destroy(data.Highlight)

			destroy(data.Billboard)

			destroy(data.Folder)

		end

	end

	table.clear(ESPObjects)
end

local function checkRound()

	local signature =
		getRoundSignature()

	if signature ~= ""
		and signature ~= LastRoundSignature then

		LastRoundSignature = signature

		RoundSignature = signature

		resetRound()
	end
end


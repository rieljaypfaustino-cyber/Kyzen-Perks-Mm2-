-- SCALE
--====================================================--

local UIScale = create(
	"UIScale",
	{
		Scale = 1,
	},
	ScreenGui
)

local function updateScale()

	local camera =
		Workspace.CurrentCamera

	if not camera then
		return
	end

	local size =
		camera.ViewportSize

	local scale =
		math.min(
			size.X / 980,
			size.Y / 690
		)

	scale =
		math.clamp(
			scale,
			0.70,
			1
		)

	UIScale.Scale =
		scale
end

updateScale()

if Workspace.CurrentCamera then

	Workspace.CurrentCamera
		:GetPropertyChangedSignal(
			"ViewportSize"
		)
		:Connect(updateScale)

end


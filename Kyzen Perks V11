--====================================================--
-- UPDATE ESP
--====================================================--

local function updateESP(player)

	if player == LocalPlayer then
		return
	end

	if not ESPEnabled then

		clearESP(player)

		return
	end

	local character =
		player.Character

	if not character then

		clearESP(player)

		return
	end

	local humanoid =
		character:FindFirstChildOfClass(
			"Humanoid"
		)

	if not humanoid
		or humanoid.Health <= 0 then

		clearESP(player)

		return
	end

	local root =
		getRoot(player)

	if not root then

		clearESP(player)

		return
	end

	-- Ensure only ONE ESP exists.
	local data =
		ESPObjects[player]

	if not data
		or not data.Folder
		or data.Folder.Parent ~= character then

		createESP(player)

		data =
			ESPObjects[player]
	end

	if not data then
		return
	end

	local role =
		select(
			1,
			detectRole(player)
		)

	local roleColor =
		getRoleColor(role)

	-- Highlight.
	data.Highlight.Enabled = true

	data.Highlight.FillColor =
		roleColor

	data.Highlight.OutlineColor =
		roleColor

	data.Highlight.FillTransparency =
		0.82

	data.Highlight.OutlineTransparency =
		0

	-- Billboard.
	data.Billboard.Enabled =
		ESPEnabled

	data.Accent.BackgroundColor3 =
		roleColor

	data.NameLabel.Text =
		player.DisplayName

	local localRoot =
		getRoot(LocalPlayer)

	local distanceText =
		"— studs"

	if localRoot then

		local distance =
			(root.Position
				- localRoot.Position).Magnitude

		distanceText =
			tostring(
				math.floor(
					distance + 0.5
				)
			)
			.. " studs"
	end

	data.InfoLabel.Text =
		"@"
		.. player.Name
		.. "  •  "
		.. role
		.. "  •  "
		.. distanceText

	data.InfoLabel.TextColor3 =
		roleColor
end

--====================================================--
-- DUPLICATE CLEANUP
--====================================================--

local function removeDuplicateESP(player)

	local character =
		player.Character

	if not character then
		return
	end

	local found = false

	for _, child in ipairs(
		character:GetChildren()
	) do

		if child.Name == "KYZEN_ESP" then

			if found then

				destroy(child)

			else

				found = true
			end
		end
	end
end

--====================================================--
-- REFRESH ALL ESP
--====================================================--

local function refreshESP()

	if not ESPEnabled then

		for player in pairs(ESPObjects) do
			clearESP(player)
		end

		return
	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer then

			removeDuplicateESP(player)

			updateESP(player)
		end
	end

	-- Remove ESP of players that no longer exist.
	for player in pairs(ESPObjects) do

		if not player.Parent then
			clearESP(player)
		end
	end
end


--====================================================--

task.spawn(function()

	while ScreenGui.Parent do

		-- This deliberately runs even before
		-- the round starts so replicated role
		-- attributes can appear immediately.

		for _, player in ipairs(
			Players:GetPlayers()
		) do

			if player ~= LocalPlayer then

				local role =
					select(
						1,
						detectRole(player)
					)

				PlayerRoles[player.UserId] =
					role
			end
		end

		if ActiveTab == "ESP" then
			rebuildPlayerList()
		end

		task.wait(0.5)
	end
end)


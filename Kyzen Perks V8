-- CHARACTER EVENTS
--------------------------------------------------------

local function hookPlayer(player)

	player.CharacterAdded:Connect(function(character)

		if player == FirstSheriff then
			FirstSheriffAlive = true
		end

		local humanoid = character:WaitForChild(
			"Humanoid",
			5
		)

		if humanoid then

			humanoid.Died:Connect(function()

				if player == FirstSheriff then
					markSheriffDead(player)
				elseif PreviousRoles[player] == "Hero" then

					LastGunOwner = player
					LastGunOwnerPosition =
						getCharacterPosition(player)

				end
			end)
		end
	end)

	if player.Character then

		local humanoid = getHumanoid(player.Character)

		if humanoid then
			humanoid.Died:Connect(function()

				if player == FirstSheriff then
					markSheriffDead(player)
				elseif PreviousRoles[player] == "Hero" then

					LastGunOwner = player
					LastGunOwnerPosition =
						getCharacterPosition(player)

				end
			end)
		end
	end
end

for _, player in ipairs(Players:GetPlayers()) do
	if player ~= LocalPlayer then
		hookPlayer(player)
	end
end

Players.PlayerAdded:Connect(function(player)

	if player ~= LocalPlayer then
		hookPlayer(player)
	end

	task.delay(1, function()
		updateFirstSheriff()
	end)
end)

--------------------------------------------------------
-- GUN / DROP DETECTION
--------------------------------------------------------

local function hasGreenParticle(object)

	if not object then
		return false
	end

	for _, descendant in ipairs(object:GetDescendants()) do

		if descendant:IsA("ParticleEmitter") then

			local color = descendant.Color

			if color then

				local keypoints = color.Keypoints

				for _, keypoint in ipairs(keypoints) do

					local c = keypoint.Value

					if c.G > c.R * 1.25
						and c.G > c.B * 1.05
						and c.G > 0.35
					then
						return true
					end
				end
			end
		end
	end

	return false
end

local function hasGunAttribute(object)

	if not object then
		return false
	end

	local attributeNames = {
		"Gun",
		"IsGun",
		"SheriffGun",
		"Weapon",
		"IsWeapon",
		"DroppedGun",
		"HeroGun",
	}

	for _, name in ipairs(attributeNames) do

		local value = object:GetAttribute(name)

		if value == true then
			return true
		end
	end

	return false
end

local function looksLikeDroppedGun(object)

	if not object then
		return false
	end

	local name = string.lower(object.Name)

	----------------------------------------------------
	-- STRONG NAME MATCH
	----------------------------------------------------

	if contains(name, CONFIG.GUN_WORDS) then
		return true
	end

	----------------------------------------------------
	-- DROP NAME
	----------------------------------------------------

	if string.find(name, "drop", 1, true)
		or string.find(name, "dropped", 1, true)
	then

		if hasGreenParticle(object) then
			return true
		end
	end

	----------------------------------------------------
	-- ATTRIBUTE MATCH
	----------------------------------------------------

	if hasGunAttribute(object) then
		return true
	end

	----------------------------------------------------
	-- GREEN PARTICLE + WEAPON/DROP WORD
	----------------------------------------------------

	if hasGreenParticle(object) then

		if string.find(name, "drop", 1, true)
			or string.find(name, "gun", 1, true)
			or string.find(name, "weapon", 1, true)
			or string.find(name, "sheriff", 1, true)
			or string.find(name, "pistol", 1, true)
		then
			return true
		end
	end

	return false
end

--------------------------------------------------------
-- GET TOUCHABLE PART
--------------------------------------------------------

local function getTouchablePart(object)

	if not object then
		return nil
	end

	----------------------------------------------------
	-- TOOL
	----------------------------------------------------

	if object:IsA("Tool") then

		local handle = object:FindFirstChild("Handle")

		if handle and handle:IsA("BasePart") then
			return handle
		end
	end

	----------------------------------------------------
	-- PART
	----------------------------------------------------

	if object:IsA("BasePart") then

		if object.CanTouch then
			return object
		end

		return object
	end

	----------------------------------------------------
	-- MODEL
	----------------------------------------------------

	if object:IsA("Model") then

		local handle = object:FindFirstChild(
			"Handle",
			true
		)

		if handle and handle:IsA("BasePart") then
			return handle
		end

		local primary = object.PrimaryPart

		if primary then
			return primary
		end

		for _, descendant in ipairs(object:GetDescendants()) do

			if descendant:IsA("BasePart") then

				if descendant.CanTouch then
					return descendant
				end
			end
		end
	end

	return nil
end

--------------------------------------------------------
-- FIND DROPPED GUN
--------------------------------------------------------

local function findDroppedGun()

	local characterPosition =
		getCharacterPosition(LocalPlayer)

	if not characterPosition then
		return nil
	end

	local bestObject = nil
	local bestPart = nil
	local bestDistance = math.huge

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		------------------------------------------------
		-- Ignore player characters
		------------------------------------------------

		local belongsToPlayer = false

		for _, player in ipairs(
			Players:GetPlayers()
		) do

			if player.Character
				and object:IsDescendantOf(
					player.Character
				)
			then
				belongsToPlayer = true
				break
			end
		end

		if belongsToPlayer then
			continue
		end

		------------------------------------------------
		-- DETECT DROP
		------------------------------------------------

		if looksLikeDroppedGun(object) then

			local part = getTouchablePart(object)

			if part then

				local distance =
					(characterPosition - part.Position).Magnitude

				if distance <= CONFIG.MAX_PICK_DISTANCE then

					if distance < bestDistance then

						bestDistance = distance
						bestObject = object
						bestPart = part
					end
				end
			end
		end
	end

	return bestObject, bestPart
end

--------------------------------------------------------
-- FIND GUN NEAR LAST OWNER
--------------------------------------------------------

local function findGunNearPosition(position)

	if not position then
		return nil
	end

	local bestObject = nil
	local bestPart = nil
	local bestDistance = math.huge

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		if looksLikeDroppedGun(object) then

			local part = getTouchablePart(object)

			if part then

				local distance =
					(part.Position - position).Magnitude

				if distance < bestDistance
					and distance <= 100
				then

					bestDistance = distance
					bestObject = object
					bestPart = part
				end
			end
		end
	end

	return bestObject, bestPart
end


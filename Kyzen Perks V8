--------------------------------------------------------
-- UTILITY
--------------------------------------------------------

local function disconnectConnection(connection)
	if connection then
		pcall(function()
			connection:Disconnect()
		end)
	end
end

local function clearConnections()
	for _, connection in ipairs(Connections) do
		disconnectConnection(connection)
	end

	table.clear(Connections)
end

local function contains(text, words)
	text = string.lower(tostring(text or ""))

	for _, word in ipairs(words) do
		if string.find(text, string.lower(word), 1, true) then
			return true
		end
	end

	return false
end

local function getRoot(character)
	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("Torso")
		or character:FindFirstChild("UpperTorso")
end

local function getHumanoid(character)
	if not character then
		return nil
	end

	return character:FindFirstChildOfClass("Humanoid")
end

local function getObjectPosition(object)
	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Attachment") then
		return object.WorldPosition
	end

	if object:IsA("Model") then
		local primary = object.PrimaryPart

		if primary then
			return primary.Position
		end

		local root = object:FindFirstChildWhichIsA("BasePart", true)

		if root then
			return root.Position
		end
	end

	return nil
end

local function getCharacterPosition(player)
	if not player.Character then
		return nil
	end

	local root = getRoot(player.Character)

	if root then
		return root.Position
	end

	return nil
end

--------------------------------------------------------
-- ROLE NORMALIZATION
--------------------------------------------------------

local function normalizeRole(role)
	if not role then
		return nil
	end

	role = string.lower(tostring(role))

	if role == "murder"
		or role == "murderer"
		or role == "killer"
	then
		return "Murderer"
	end

	if role == "sheriff"
		or role == "cop"
	then
		return "Sheriff"
	end

	if role == "hero" then
		return "Hero"
	end

	if role == "innocent"
		or role == "civilian"
		or role == "survivor"
	then
		return "Innocent"
	end

	return nil
end

--------------------------------------------------------
-- ROLE ATTRIBUTE
--------------------------------------------------------

local function getRoleAttribute(player)
	if not player then
		return nil
	end

	for _, attributeName in ipairs(CONFIG.ROLE_ATTRIBUTE_NAMES) do
		local value = player:GetAttribute(attributeName)

		if value ~= nil then
			local normalized = normalizeRole(value)

			if normalized then
				return normalized
			end
		end
	end

	if player.Character then
		for _, attributeName in ipairs(CONFIG.ROLE_ATTRIBUTE_NAMES) do
			local value = player.Character:GetAttribute(attributeName)

			if value ~= nil then
				local normalized = normalizeRole(value)

				if normalized then
					return normalized
				end
			end
		end
	end

	return nil
end

--------------------------------------------------------
-- TOOL SEARCH
--------------------------------------------------------

local function findToolInContainer(container, words)
	if not container then
		return nil
	end

	for _, object in ipairs(container:GetChildren()) do
		if object:IsA("Tool") then
			if contains(object.Name, words) then
				return object
			end
		end
	end

	return nil
end

local function playerHasKnife(player)
	if not player then
		return false
	end

	local backpack = player:FindFirstChildOfClass("Backpack")

	if backpack and findToolInContainer(backpack, CONFIG.KNIFE_WORDS) then
		return true
	end

	if player.Character and findToolInContainer(player.Character, CONFIG.KNIFE_WORDS) then
		return true
	end

	return false
end

local function playerHasGun(player)
	if not player then
		return false
	end

	local backpack = player:FindFirstChildOfClass("Backpack")

	if backpack and findToolInContainer(backpack, CONFIG.GUN_WORDS) then
		return true
	end

	if player.Character and findToolInContainer(player.Character, CONFIG.GUN_WORDS) then
		return true
	end

	return false
end

--------------------------------------------------------
-- ROLE DETECTION
--------------------------------------------------------

local function detectRole(player)
	if not player then
		return "Innocent"
	end

	----------------------------------------------------
	-- SERVER ROLE ATTRIBUTE HAS PRIORITY
	----------------------------------------------------

	local serverRole = getRoleAttribute(player)

	if serverRole then

		-- If server explicitly says Hero,
		-- never downgrade to Sheriff because of gun.
		if serverRole == "Hero" then
			return "Hero"
		end

		if serverRole == "Murderer" then
			return "Murderer"
		end

		if serverRole == "Sheriff" then
			return "Sheriff"
		end

		if serverRole == "Innocent" then
			-- Continue below only for Hero fallback.
			if PreviousRoles[player] ~= "Hero" then
				return "Innocent"
			end
		end
	end

	----------------------------------------------------
	-- HERO STATE HAS PRIORITY OVER GUN
	----------------------------------------------------

	if PreviousRoles[player] == "Hero" then
		return "Hero"
	end

	----------------------------------------------------
	-- MURDERER
	----------------------------------------------------

	if playerHasKnife(player) then
		return "Murderer"
	end

	----------------------------------------------------
	-- FIRST SHERIFF
	----------------------------------------------------

	if player == FirstSheriff
		and FirstSheriffAlive
		and not FirstSheriffLeft
	then
		return "Sheriff"
	end

	----------------------------------------------------
	-- FALLBACK SHERIFF
	----------------------------------------------------

	if playerHasGun(player) then

		-- If this player has not previously been identified
		-- as Hero, and they are holding the initial Sheriff
		-- gun, they can be treated as Sheriff.
		if player == FirstSheriff then
			return "Sheriff"
		end

		-- If the gun is an eligible dropped Hero gun,
		-- do NOT automatically call the holder Sheriff.
		if PreviousRoles[player] == "Hero" then
			return "Hero"
		end

		-- Unknown gun holder.
		-- This fallback is intentionally Sheriff only
		-- when no previous Hero state exists.
		return "Sheriff"
	end

	----------------------------------------------------
	-- INNOCENT
	----------------------------------------------------

	return "Innocent"
end


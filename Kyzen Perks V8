--------------------------------------------------------
-- LOCAL PLAYER ROLE WATCH
--------------------------------------------------------

task.spawn(function()

	local lastRole = nil

	while MainGui.Parent do

		local role =
			detectRole(
				LocalPlayer
			)

		------------------------------------------------
		-- IF SERVER SAYS HERO
		------------------------------------------------

		if getRoleAttribute(
			LocalPlayer
		) == "Hero"
		then
			PreviousRoles[LocalPlayer] =
				"Hero"
		end

		------------------------------------------------
		-- DETECT LEGITIMATE GUN PICKUP
		------------------------------------------------

		if localPlayerHasGun()
			and role ~= "Sheriff"
			and role ~= "Murderer"
		then

			if not FirstSheriffAlive
				and FirstSheriff
			then

				PreviousRoles[LocalPlayer] =
					"Hero"

			end
		end

		if role ~= lastRole then

			lastRole =
				role

			updatePlayerList()
		end

		task.wait(0.25)
	end
end)


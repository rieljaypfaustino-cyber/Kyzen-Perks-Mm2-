--------------------------------------------------------

local function tryAssignHero()

	if not localPlayerHasGun() then
		return
	end

	local currentRole =
		getRoleAttribute(LocalPlayer)

	----------------------------------------------------
	-- SERVER SAYS SHERIFF
	----------------------------------------------------

	if currentRole == "Sheriff" then
		return
	end

	----------------------------------------------------
	-- SERVER SAYS MURDERER
	----------------------------------------------------

	if currentRole == "Murderer" then
		return
	end

	----------------------------------------------------
	-- IF WE PICKED UP THE ELIGIBLE DROPPED GUN
	----------------------------------------------------

	if not FirstSheriffAlive
		and FirstSheriff
	then

		PreviousRoles[LocalPlayer] = "Hero"

		return
	end

	----------------------------------------------------
	-- LAST OWNER WAS HERO
	----------------------------------------------------

	if LastGunOwner
		and LastGunOwner ~= LocalPlayer
	then

		PreviousRoles[LocalPlayer] = "Hero"
	end
end

--------------------------------------------------------
-- AUTO PICK
--------------------------------------------------------

local AutoPickBusy = false

local function autoPickGun()

	if not AutoPickEnabled then
		return
	end

	if AutoPickBusy then
		return
	end

	----------------------------------------------------
	-- MUST BE INNOCENT
	----------------------------------------------------

	local currentRole =
		detectRole(LocalPlayer)

	if currentRole ~= "Innocent" then
		return
	end

	----------------------------------------------------
	-- FIND TARGET
	----------------------------------------------------

	local gunObject
	local gunPart

	----------------------------------------------------
	-- FIRST: FIND NEAR LAST SHERIFF/HERO
	----------------------------------------------------

	if EligibleHeroGunPosition then

		gunObject, gunPart =
			findGunNearPosition(
				EligibleHeroGunPosition
			)
	end

	----------------------------------------------------
	-- SECOND: GENERAL SEARCH
	----------------------------------------------------

	if not gunObject then

		gunObject, gunPart =
			findDroppedGun()
	end

	if not gunObject or not gunPart then
		return
	end

	AutoPickBusy = true

	local character =
		LocalPlayer.Character

	local root =
		getRoot(character)

	if not root then
		AutoPickBusy = false
		return
	end

	----------------------------------------------------
	-- SAVE ORIGINAL POSITION
	----------------------------------------------------

	local oldCFrame = root.CFrame

	----------------------------------------------------
	-- TELEPORT TO DROP
	----------------------------------------------------

	pcall(function()

		root.CFrame =
			CFrame.new(
				gunPart.Position
				+ Vector3.new(
					0,
					CONFIG.TELEPORT_HEIGHT,
					0
				)
			)

	end)

	----------------------------------------------------
	-- LET PHYSICS / TOUCHED SYSTEM RUN
	----------------------------------------------------

	local startTime = os.clock()

	while os.clock() - startTime
		< CONFIG.PICKUP_WAIT
	do

		if localPlayerHasGun() then
			break
		end

		task.wait(0.05)

		------------------------------------------------
		-- Keep character close enough to touch
		------------------------------------------------

		if root
			and root.Parent
			and gunPart
			and gunPart.Parent
		then

			local distance =
				(root.Position - gunPart.Position).Magnitude

			if distance > 7 then

				pcall(function()

					root.CFrame =
						CFrame.new(
							gunPart.Position
								+ Vector3.new(
									0,
									2.5,
									0
								)
						)

				end)
			end
		end
	end

	----------------------------------------------------
	-- WAIT FOR BACKPACK REPLICATION
	----------------------------------------------------

	task.wait(CONFIG.RETURN_DELAY)

	----------------------------------------------------
	-- IF LEGITIMATE PICKUP HAPPENED
	----------------------------------------------------

	if localPlayerHasGun() then

		------------------------------------------------
		-- Mark Hero ONLY if this was a dropped
		-- Sheriff/Hero gun and server didn't identify
		-- us as Sheriff.
		------------------------------------------------

		tryAssignHero()
	end

	----------------------------------------------------
	-- RETURN TO OLD POSITION
	----------------------------------------------------

	if root and root.Parent then

		pcall(function()

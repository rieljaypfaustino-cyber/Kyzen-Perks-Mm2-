-- ROUND WATCHER
--------------------------------------------------------

task.spawn(function()

	while MainGui.Parent do

		local signature =
			getRoundSignature()

		if CurrentRoundSignature == nil then

			CurrentRoundSignature =
				signature

		elseif signature
			~= CurrentRoundSignature
		then

			CurrentRoundSignature =
				signature

			------------------------------------------------
			-- NEW ROUND
			------------------------------------------------

			resetRoundMemory()

			hardResetESP()

			task.wait(0.2)

			updateFirstSheriff()

			updatePlayerList()
		end

		CurrentRoundState =
			getFirstAttribute(
				Workspace,
				CONFIG.STATE_ATTRIBUTE_NAMES
			)

		task.wait(0.5)
	end
end)

--------------------------------------------------------
-- FIRST SHERIFF WATCHER
--------------------------------------------------------

task.spawn(function()

	while MainGui.Parent do

		updateFirstSheriff()

		------------------------------------------------
		-- CHECK FIRST SHERIFF STATUS
		------------------------------------------------

		if FirstSheriff then

			local character =
				FirstSheriff.Character

			local humanoid =
				getHumanoid(character)

			if humanoid then

				if humanoid.Health <= 0 then

					if FirstSheriffAlive then
						markSheriffDead(
							FirstSheriff
						)
					end

				else

					if not FirstSheriffLeft then
						FirstSheriffAlive = true
					end
				end
			end
		end

		------------------------------------------------
		-- LOOK FOR DROPPED HERO GUN
		------------------------------------------------

		if not FirstSheriffAlive
			and FirstSheriff
		then

			local object, part =
				findGunNearPosition(
					EligibleHeroGunPosition
				)

			if object and part then
				EligibleHeroGun =
					object
			end
		end

		task.wait(
			CONFIG.GUN_SCAN_REFRESH
		)
	end
end)


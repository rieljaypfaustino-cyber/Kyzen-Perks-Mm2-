local function getFirstAttribute(container, names)
	if not container then
		return nil
	end

	for _, name in ipairs(names) do
		local value = container:GetAttribute(name)

		if value ~= nil then
			return value
		end
	end

	return nil
end

local function getRoundSignature()
	local roundId = getFirstAttribute(
		Workspace,
		CONFIG.ROUND_ATTRIBUTE_NAMES
	)

	if roundId == nil then
		roundId = getFirstAttribute(
			game:GetService("ReplicatedStorage"),
			CONFIG.ROUND_ATTRIBUTE_NAMES
		)
	end

	local state = getFirstAttribute(
		Workspace,
		CONFIG.STATE_ATTRIBUTE_NAMES
	)

	if state == nil then
		state = getFirstAttribute(
			game:GetService("ReplicatedStorage"),
			CONFIG.STATE_ATTRIBUTE_NAMES
		)
	end

	return tostring(roundId or "NO_ROUND")
		.. "|"
		.. tostring(state or "NO_STATE")
end


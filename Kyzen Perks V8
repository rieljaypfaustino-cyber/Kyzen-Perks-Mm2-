local function setMainVisible(visible)

	MainOpen =
		visible

	if visible then

		MainFrame.Visible =
			true

		MainFrame.Size =
			UDim2.fromOffset(
				420,
				265
			)

		TweenService:Create(
			MainFrame,
			TweenInfo.new(
				0.22,
				Enum.EasingStyle.Back,
				Enum.EasingDirection.Out
			),
			{
				Size =
					UDim2.fromOffset(
						440,
						280
					)
			}
		):Play()

	else

		local tween =
			TweenService:Create(
				MainFrame,
				TweenInfo.new(
					0.18,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In
				),
				{
					Size =
						UDim2.fromOffset(
							400,
							245
						),

					BackgroundTransparency =
						1
				}
			)

		tween:Play()

		tween.Completed:Once(
			function()

				if not MainOpen then

					MainFrame.Visible =
						false

					MainFrame.BackgroundTransparency =
						0
				end
			end
		)
	end
end


local function resetRoundMemory()

	FirstSheriff = nil
	FirstSheriffUserId = nil

	FirstSheriffAlive = false
	FirstSheriffLeft = false

	EligibleHeroGun = nil
	EligibleHeroGunPosition = nil

	LastGunOwner = nil
	LastGunOwnerPosition = nil

	table.clear(PreviousRoles)
end

--------------------------------------------------------
-- DETECT FIRST SHERIFF
--------------------------------------------------------

local function updateFirstSheriff()
	if FirstSheriff then
		return
	end

	for _, player in ipairs(Players:GetPlayers()) do

		local serverRole = getRoleAttribute(player)

		if serverRole == "Sheriff" then
			FirstSheriff = player
			FirstSheriffUserId = player.UserId
			FirstSheriffAlive = true
			FirstSheriffLeft = false

			return
		end
	end

	----------------------------------------------------
	-- FALLBACK: FIND A PLAYER HOLDING A GUN
	----------------------------------------------------

	for _, player in ipairs(Players:GetPlayers()) do

		if playerHasGun(player) and not playerHasKnife(player) then

			FirstSheriff = player
			FirstSheriffUserId = player.UserId
			FirstSheriffAlive = true
			FirstSheriffLeft = false

			return
		end
	end
end

--------------------------------------------------------
-- FIRST SHERIFF DEATH DETECTION
--------------------------------------------------------

local function markSheriffDead(player)
	if not player then
		return
	end

	if player ~= FirstSheriff then
		return
	end

	FirstSheriffAlive = false

	LastGunOwner = player
	LastGunOwnerPosition = getCharacterPosition(player)

	----------------------------------------------------
	-- THE FIRST SHERIFF'S GUN BECOMES HERO ELIGIBLE
	----------------------------------------------------

	EligibleHeroGun = nil
	EligibleHeroGunPosition = LastGunOwnerPosition
end

--------------------------------------------------------
-- PLAYER LEAVE
--------------------------------------------------------

Players.PlayerRemoving:Connect(function(player)

	if player == FirstSheriff then

		FirstSheriffLeft = true
		FirstSheriffAlive = false

		LastGunOwner = player

		------------------------------------------------
		-- We cannot read the exact server drop after
		-- the player disappears, so retain their last
		-- known position as the search target.
		------------------------------------------------

		if player.Character then
			LastGunOwnerPosition = getCharacterPosition(player)
		end

		EligibleHeroGun = nil
		EligibleHeroGunPosition = LastGunOwnerPosition
	end

	PreviousRoles[player] = nil

	if ESPData[player] then
		local data = ESPData[player]

		if data.Highlight then
			data.Highlight:Destroy()
		end

		if data.Billboard then
			data.Billboard:Destroy()
		end

		ESPData[player] = nil
	end
end)


--------------------------------------------------------
-- UPDATE ESP
--------------------------------------------------------

local function updateESP(player)

	if player == LocalPlayer then
		return
	end

	if not CONFIG.ESP_ENABLED then
		removeESP(player)
		return
	end

	local character =
		player.Character

	local root =
		getRoot(character)

	if not character or not root then
		removeESP(player)
		return
	end

	local role =
		detectRole(player)

	local color =
		ROLE_COLORS[role]
		or ROLE_COLORS.Innocent

	local data =
		ESPData[player]

	if not data then

		createESP(player)

		data =
			ESPData[player]

		if not data then
			return
		end
	end

	----------------------------------------------------
	-- ROLE CHANGED
	----------------------------------------------------

	if data.Role ~= role then

		createESP(player)

		data =
			ESPData[player]

		if not data then
			return
		end
	end

	----------------------------------------------------
	-- UPDATE COLOR
	----------------------------------------------------

	data.Role =
		role

	data.Highlight.FillColor =
		color

	data.Highlight.OutlineColor =
		color

	data.RoleLabel.Text =
		role

	data.RoleLabel.TextColor3 =
		color

	----------------------------------------------------
	-- DISTANCE
	----------------------------------------------------

	local localPosition =
		getCharacterPosition(
			LocalPlayer
		)

	if localPosition then

		local distance =
			(
				root.Position
				- localPosition
			).Magnitude

		data.DistanceLabel.Text =
			string.format(
				"Distance: %d studs",
				math.floor(distance)
			)
	end
end


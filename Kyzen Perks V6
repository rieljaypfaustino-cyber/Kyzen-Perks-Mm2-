--------------------------------------------------------
-- ROLE DETECTION
--------------------------------------------------------

local function detectRole(player)

	----------------------------------------------------
	-- SERVER ROLE ATTRIBUTE
	----------------------------------------------------

	local attributeRole =
		getAttributeRole(player)

	if attributeRole then

		PreviousRoles[player] =
			attributeRole

		return attributeRole

	end

	----------------------------------------------------
	-- TEAM
	----------------------------------------------------

	local teamRole =
		getTeamRole(player)

	if teamRole then

		PreviousRoles[player] =
			teamRole

		return teamRole

	end

	----------------------------------------------------
	-- KNIFE
	----------------------------------------------------

	if hasKnife(player) then

		PreviousRoles[player] =
			"Murderer"

		return "Murderer"

	end

	----------------------------------------------------
	-- GUN
	----------------------------------------------------

	if hasGun(player) then

		local previous =
			PreviousRoles[player]

		if previous == "Innocent" then

			PreviousRoles[player] =
				"Hero"

			return "Hero"

		end

		PreviousRoles[player] =
			"Sheriff"

		return "Sheriff"

	end

	----------------------------------------------------
	-- NO WEAPON
	----------------------------------------------------

	-- IMPORTANT:
	-- We intentionally return Innocent instead of
	-- preserving an old Sheriff/Murderer role.
	--
	-- This prevents stale ESP after a round ends.

	PreviousRoles[player] =
		"Innocent"

	return "Innocent"

end

--------------------------------------------------------
-- ROLE COLOR
--------------------------------------------------------

local function getRoleColor(role)

	if role == "Murderer" then

		return COLORS.RED

	end

	if role == "Sheriff" then

		return COLORS.BLUE

	end

	if role == "Hero" then

		return COLORS.YELLOW

	end

	return COLORS.GREEN

end

--------------------------------------------------------
-- DESTROY ESP
--------------------------------------------------------

local function removeESP(player)

	local data =
		ESPObjects[player]

	if not data then

		return

	end

	destroy(data.Highlight)

	destroy(data.Billboard)

	ESPObjects[player] = nil

end

--------------------------------------------------------
-- CLEAR ALL ESP
--------------------------------------------------------

local function clearAllESP()

	for player in pairs(
		ESPObjects
	) do

		removeESP(player)

	end

end

--------------------------------------------------------
-- CREATE ESP
--------------------------------------------------------

local function createESP(player)

	if player == LocalPlayer then

		return

	end

	local character =
		player.Character

	local root =
		getRoot(player)

	if not character
		or not root then

		return

	end

	removeESP(player)

	local role =
		detectRole(player)

	local color =
		getRoleColor(role)

	----------------------------------------------------
	-- HIGHLIGHT
	----------------------------------------------------

	local highlight =
		Instance.new("Highlight")

	highlight.Name =
		"KYZEN_ESP_HIGHLIGHT"

	highlight.Adornee =
		character

	highlight.DepthMode =
		Enum.HighlightDepthMode.AlwaysOnTop

	highlight.FillColor =
		color

	highlight.OutlineColor =
		color

	highlight.FillTransparency =
		0.60

	highlight.OutlineTransparency =
		0

	highlight.Parent =
		character

	----------------------------------------------------
	-- BILLBOARD
	----------------------------------------------------

	local billboard =
		Instance.new("BillboardGui")

	billboard.Name =
		"KYZEN_ESP_INFO"

	billboard.Adornee =
		root

	billboard.Size =
		UDim2.fromOffset(
			245,
			55
		)

	billboard.StudsOffset =
		Vector3.new(
			0,
			3.5,
			0
		)

	billboard.AlwaysOnTop =
		true

	billboard.MaxDistance =
		10000

	billboard.Parent =
		character

	----------------------------------------------------
	-- LABEL
	----------------------------------------------------

	local label =
		Instance.new("TextLabel")

	label.Size =
		UDim2.fromScale(
			1,
			1
		)

	label.BackgroundTransparency =
		1

	label.Font =
		Enum.Font.GothamBold

	label.TextSize =
		12

	label.TextColor3 =
		color

	label.TextStrokeColor3 =
		COLORS.BLACK

	label.TextStrokeTransparency =
		0

	label.TextWrapped =
		true

	label.Parent =
		billboard

	ESPObjects[player] = {

		Highlight = highlight,

		Billboard = billboard,

		Label = label,

		Role = role,

	}

end

--------------------------------------------------------
-- UPDATE ESP
--------------------------------------------------------

local function updateESP(player)

	if player == LocalPlayer then

		return

	end

	if not CONFIG.ESP_ENABLED then

		removeESP(player)

		return

	end

	local character =
		player.Character

	local root =
		getRoot(player)

	if not character
		or not root then

		removeESP(player)

		return

	end

	local role =
		detectRole(player)

	local color =
		getRoleColor(role)

	local data =
		ESPObjects[player]

	----------------------------------------------------
	-- RECREATE IF OLD ESP DOESN'T MATCH CHARACTER
	----------------------------------------------------

	if not data
		or not data.Highlight
		or not data.Billboard
		or data.Highlight.Adornee ~= character then

		createESP(player)

		data =
			ESPObjects[player]

	end

	if not data then

		return

	end

	----------------------------------------------------
	-- ROLE CHANGED
	----------------------------------------------------

	if data.Role ~= role then

		createESP(player)

		data =
			ESPObjects[player]

	end

	if not data then

		return

	end

	data.Role =
		role

	data.Highlight.FillColor =
		color

	data.Highlight.OutlineColor =
		color

	data.Label.TextColor3 =
		color

	----------------------------------------------------
	-- DISTANCE
	----------------------------------------------------

	local distance = 0

	local localRoot =
		getRoot(LocalPlayer)

	if localRoot then

		distance =
			math.floor(
				(
					localRoot.Position
					- root.Position
				).Magnitude
			)

	end

	----------------------------------------------------
	-- TEXT
	----------------------------------------------------

	data.Label.Text =
		player.DisplayName
		.. "  @"
		.. player.Name
		.. "\n"
		.. role
		.. "  •  "
		.. distance
		.. " studs"

end

--------------------------------------------------------
-- HARD ESP RESET
--------------------------------------------------------

local function hardResetESP()

	----------------------------------------------------
	-- Destroy everything first
	----------------------------------------------------

	clearAllESP()

	----------------------------------------------------
	-- Forget old roles
	----------------------------------------------------

	PreviousRoles = {}

	----------------------------------------------------
	-- Rebuild current players
	----------------------------------------------------

	if not CONFIG.ESP_ENABLED then

		return

	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer then

			updateESP(player)

		end

	end

end

--------------------------------------------------------
-- ROUND SIGNATURE
--------------------------------------------------------

local function getRoundSignature()

	for _, name in ipairs({

		"RoundId",
		"Round",
		"RoundNumber",
		"CurrentRound",
		"GameRound",

	}) do

		local value =
			Workspace:GetAttribute(
				name
			)

		if value ~= nil then

			return name
				.. ":"
				.. tostring(value)

		end

	end

	return nil

end

--------------------------------------------------------
-- ROUND STATE
--------------------------------------------------------

local function getRoundState()

	for _, name in ipairs({

		"RoundState",
		"GameState",
		"State",
		"Status",

	}) do

		local value =
			Workspace:GetAttribute(
				name
			)

		if value ~= nil then

			return lower(value)

		end

	end

	return nil

end

--------------------------------------------------------
-- ROUND CHECK
--------------------------------------------------------

local function checkRound()

	local signature =
		getRoundSignature()

	local state =
		getRoundState()

	----------------------------------------------------
	-- NEW ROUND ID
	----------------------------------------------------

	if signature then

		if CurrentRoundSignature == nil then

			CurrentRoundSignature =
				signature

		elseif CurrentRoundSignature
			~= signature then

			CurrentRoundSignature =
				signature

			hardResetESP()

		end

	end

	----------------------------------------------------
	-- ROUND STATE CHANGE
	----------------------------------------------------

	if state then

		if LastRoundState == nil then

			LastRoundState =
				state

		elseif LastRoundState
			~= state then

			LastRoundState =
				state

			------------------------------------------------
			-- Any phase transition gets a clean refresh.
			------------------------------------------------

			hardResetESP()

		end

	end

end

--------------------------------------------------------
-- PERIODIC HARD RESET
--------------------------------------------------------

local function periodicESPRefresh()

	----------------------------------------------------
	-- Every refresh:
	--
	-- 1. Remove old ESP
	-- 2. Re-check roles
	-- 3. Recreate current ESP
	--
	-- This prevents old round information from staying.
	----------------------------------------------------

	if not CONFIG.ESP_ENABLED then

		clearAllESP()

		return

	end

	clearAllESP()

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if player ~= LocalPlayer then

			updateESP(player)

		end

	end

end

--------------------------------------------------------
-- GUN DETECTION
--------------------------------------------------------

local function objectLooksLikeGun(object)

	if not object then

		return false

	end

	if contains(
		object.Name,
		CONFIG.GUN_WORDS
	) then

		return true

	end

	for _, attributeName in ipairs({

		"WeaponType",
		"ItemType",
		"Weapon",
		"Type",
		"Role",
		"Gun",

	}) do

		local value =
			object:GetAttribute(
				attributeName
			)

		if value then

			if contains(
				value,
				CONFIG.GUN_WORDS
			) then

				return true

			end

			local lowerValue =
				lower(value)

			if string.find(
				lowerValue,
				"sheriff",
				1,
				true
			) then

				return true

			end

		end

	end

	return false

end

--------------------------------------------------------
-- GREEN PARTICLE
--------------------------------------------------------

local function hasGreenParticle(object)

	for _, descendant in ipairs(
		object:GetDescendants()
	) do

		if descendant:IsA(
			"ParticleEmitter"
		) then

			local sequence =
				descendant.Color

			if sequence then

				for _, point in ipairs(
					sequence.Keypoints
				) do

					local color =
						point.Value

					if color.G > 0.45
						and color.G
						> color.R * 1.2 then

						return true

					end

				end

			end

		end

	end

	return false

end

--------------------------------------------------------
-- OBJECT PART
--------------------------------------------------------

local function getObjectPart(object)

	if not object then

		return nil

	end

	if object:IsA(
		"BasePart"
	) then

		return object

	end

	if object:IsA(
		"Tool"
	) then

		local handle =
			object:FindFirstChild(
				"Handle"
			)

		if handle
			and handle:IsA(
				"BasePart"
			) then

			return handle

		end

	end

	return object:FindFirstChildWhichIsA(
		"BasePart",
		true
	)

end

--------------------------------------------------------
-- CHECK PLAYER OWNERSHIP
--------------------------------------------------------

local function belongsToPlayer(object)

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		local character =
			player.Character

		if character
			and object:IsDescendantOf(
				character
			) then

			return true

		end

		local backpack =
			player:FindFirstChildOfClass(
				"Backpack"
			)

		if backpack
			and object:IsDescendantOf(
				backpack
			) then

			return true

		end

	end

	return false

end

--------------------------------------------------------
-- DROPPED GUN
--------------------------------------------------------

local function isDroppedGun(object)

	if not object then

		return false

	end

	if belongsToPlayer(
		object
	) then

		return false

	end

	if objectLooksLikeGun(
		object
	) then

		return true

	end

	----------------------------------------------------
	-- GREEN PARTICLE FALLBACK
	----------------------------------------------------

	if hasGreenParticle(
		object
	) then

		local name =
			lower(object.Name)

		if string.find(
			name,
			"drop",
			1,
			true
		)
		or string.find(
			name,
			"gun",
			1,
			true
		)
		or string.find(
			name,
			"weapon",
			1,
			true
		)
		or string.find(
			name,
			"sheriff",
			1,
			true
		) then

			return true

		end

	end

	return false

end

--------------------------------------------------------
-- FIND DROPPED GUN
--------------------------------------------------------

local function findDroppedGun()

	local root =
		getRoot(LocalPlayer)

	if not root then

		return nil

	end

	local closest = nil

	local closestDistance =
		CONFIG.MAX_GUN_DISTANCE

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		if object:IsA(
			"Tool"
		)
		or object:IsA(
			"Model"
		) then

			if isDroppedGun(
				object
			) then

				local part =
					getObjectPart(
						object
					)

				if part then

					local distance =
						(
							root.Position
							- part.Position
						).Magnitude

					if distance
						< closestDistance then

						closestDistance =
							distance

						closest = {

							Object = object,

							Part = part,

						}

					end

				end

			end

		end

	end

	return closest

end

--------------------------------------------------------
-- BACKPACK SNAPSHOT
--------------------------------------------------------

local function snapshotBackpack()

	local result = {}

	local backpack =
		LocalPlayer:FindFirstChildOfClass(
			"Backpack"
		)

	if not backpack then

		return result

	end

	for _, object in ipairs(
		backpack:GetChildren()
	) do

		if object:IsA(
			"Tool"
		) then

			result[object] = true

		end

	end

	return result

end

--------------------------------------------------------
-- FIND NEW GUN
--------------------------------------------------------

local function findNewGun(
	beforeTools
)

	local backpack =
		LocalPlayer:FindFirstChildOfClass(
			"Backpack"
		)

	if not backpack then

		return nil

	end

	for _, object in ipairs(
		backpack:GetChildren()
	) do

		if object:IsA(
			"Tool"
		) then

			if objectLooksLikeGun(
				object
			)
			and not beforeTools[object] then

				return object

			end

		end

	end

	return nil

end

--------------------------------------------------------
-- AUTO PICK
--------------------------------------------------------

local function autoPickGun()

	if not CONFIG.AUTO_PICK_ENABLED
		and not AutoPickEnabled then

		return

	end

	if AutoPickBusy then

		return

	end

	----------------------------------------------------
	-- INNOCENT ONLY
	----------------------------------------------------

	local myRole =
		detectRole(
			LocalPlayer
		)

	if myRole ~= "Innocent" then

		return

	end

	----------------------------------------------------
	-- CHARACTER
	----------------------------------------------------

	local character =
		LocalPlayer.Character

	local humanoid =
		character
		and character:FindFirstChildOfClass(
			"Humanoid"
		)

	local root =
		getRoot(LocalPlayer)

	if not character
		or not humanoid
		or humanoid.Health <= 0
		or not root then

		return

	end

	----------------------------------------------------
	-- FIND DROP
	----------------------------------------------------

	local dropped =
		findDroppedGun()

	if not dropped
		or not dropped.Part then

		return

	end

	----------------------------------------------------
	-- LOCK
	----------------------------------------------------

	AutoPickBusy = true

	----------------------------------------------------
	-- SAVE POSITION
	----------------------------------------------------

	local oldCFrame =
		root.CFrame

	local beforeTools =
		snapshotBackpack()

	----------------------------------------------------
	-- MOVE TO GUN
	----------------------------------------------------

	root.CFrame =
		CFrame.new(
			dropped.Part.Position
			+ CONFIG.TELEPORT_OFFSET
		)

	task.wait(
		0.15
	)

	----------------------------------------------------
	-- WAIT FOR NORMAL TOUCH PICKUP
	----------------------------------------------------

	local deadline =
		os.clock()
		+ CONFIG.PICKUP_WAIT

	local pickedUp = false

	while os.clock()
		< deadline do

		------------------------------------------------
		-- BACKPACK CHECK
		------------------------------------------------

		local gun =
			findNewGun(
				beforeTools
			)

		if gun then

			pickedUp = true

			break

		end

		------------------------------------------------
		-- DROPPED OBJECT GONE
		------------------------------------------------

		if not dropped.Object
			or not dropped.Object.Parent then

			task.wait(
				0.15
			)

			local gun2 =
				findNewGun(
					beforeTools
				)

			if gun2 then

				pickedUp = true

			end

			break

		end

		task.wait(
			0.05
		)

	end

	----------------------------------------------------
	-- RETURN
	----------------------------------------------------

	task.wait(
		CONFIG.RETURN_DELAY
	)

	local newRoot =
		getRoot(
			LocalPlayer
		)

	if newRoot then

		newRoot.CFrame =
			oldCFrame

	end

	----------------------------------------------------
	-- HERO FALLBACK
	----------------------------------------------------

	if pickedUp then

		-- The actual server role should update this.
		-- This fallback is only for the client ESP.

		PreviousRoles[
			LocalPlayer
		] = "Hero"

	end

	AutoPickBusy = false

end


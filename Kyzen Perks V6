local function setupPlayer(player)

	if player == LocalPlayer then

		return

	end

	player.CharacterAdded:Connect(
		function()

			------------------------------------------------
			-- OLD ROUND ESP MUST DIE
			------------------------------------------------

			removeESP(player)

			PreviousRoles[player] =
				nil

			task.wait(
				0.35
			)

			if CONFIG.ESP_ENABLED then

				updateESP(
					player
				)

			end

		end
	)

	player.CharacterRemoving:Connect(
		function()

			removeESP(player)

			PreviousRoles[player] =
				nil

		end
	)

	----------------------------------------------------
	-- ROLE ATTRIBUTE EVENTS
	----------------------------------------------------

	for _, attributeName in ipairs(
		CONFIG.ROLE_ATTRIBUTES
	) do

		player:GetAttributeChangedSignal(
			attributeName
		):Connect(
			function()

				removeESP(player)

				PreviousRoles[player] =
					nil

				if CONFIG.ESP_ENABLED then

					task.defer(
						function()

							updateESP(
								player
							)

						end
					)

				end

			end
		)

	end

	----------------------------------------------------
	-- TEAM CHANGE
	----------------------------------------------------

	player:GetPropertyChangedSignal(
		"Team"
	):Connect(
		function()

			removeESP(player)

			PreviousRoles[player] =
				nil

		end
	)

end


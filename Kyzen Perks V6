local function setMainVisible(state)

	MainOpen =
		state

	if state then

		Main.Visible =
			true

		Main.Size =
			UDim2.fromOffset(
				410,
				255
			)

		TweenService:Create(
			Main,
			TweenInfo.new(
				0.23,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out
			),
			{
				Size =
					UDim2.fromOffset(
						440,
						280
					)
			}
		):Play()

	else

		local tween =
			TweenService:Create(
				Main,
				TweenInfo.new(
					0.18,
					Enum.EasingStyle.Quad,
					Enum.EasingDirection.In
				),
				{
					Size =
						UDim2.fromOffset(
							410,
							255
						)
				}
			)

		tween:Play()

		tween.Completed:Connect(
			function()

				if not MainOpen then

					Main.Visible =
						false

				end

			end
		)

	end

end


--====================================================--

local function watchContainer(container, player)

	if not container then
		return
	end

	container.ChildAdded:Connect(function(child)

		if player ~= LocalPlayer
			and objectLooksLikeGun(child) then

			local role = detectRole(player)

			if role == "Sheriff" then

				if RoundFirstSheriffUserId == nil then
					RoundFirstSheriffUserId = player.UserId
				end

				RoundGunHolderUserId = player.UserId
			end
		end

		task.delay(0.05, function()
			if player.Parent then
				updateESPPlayer(player)
			end
		end)
	end)

	container.ChildRemoved:Connect(function(child)

		if objectLooksLikeGun(child) then

			local root = getRoot(player)

			if root then
				LastGunDropCFrame = root.CFrame
			end

			LastGunHolderUserId = player.UserId
		end

		task.delay(0.05, function()
			if player.Parent then
				updateESPPlayer(player)
			end
		end)
	end)
end

local function setupPlayerContainers(player)

	local backpack = player:FindFirstChildOfClass("Backpack")

	if backpack then
		watchContainer(backpack, player)
	end

	player.ChildAdded:Connect(function(child)

		if child:IsA("Backpack") then
			watchContainer(child, player)
		end
	end)

	if player.Character then
		watchContainer(player.Character, player)
	end

	player.CharacterAdded:Connect(function(character)
		watchContainer(character, player)
	end)
end

for _, player in ipairs(Players:GetPlayers()) do
	setupPlayerContainers(player)
end

Players.PlayerAdded:Connect(function(player)
	setupPlayerContainers(player)
end)


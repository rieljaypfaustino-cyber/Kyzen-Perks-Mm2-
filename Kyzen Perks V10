			},
			0.12
		)
	end)

	button.MouseButton1Down:Connect(function()
		tween(
			button,
			{
				Size = UDim2.new(
					originalSize.X.Scale,
					originalSize.X.Offset - 2,
					originalSize.Y.Scale,
					originalSize.Y.Offset - 2
				),
			},
			0.08
		)
	end)

	button.MouseButton1Up:Connect(function()
		tween(
			button,
			{
				Size = originalSize,
			},
			0.1
		)
	end)

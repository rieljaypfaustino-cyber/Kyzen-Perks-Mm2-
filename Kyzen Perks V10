-- AUTO PICK
--====================================================--

local function isLocalInnocent()
	local role = detectRole(LocalPlayer)

	return role == "Innocent"
end

local function hasLocalGun()
	return playerHasGun(LocalPlayer)
end

local function getCharacterCFrame()
	local root = getRoot(LocalPlayer)

	if root then
		return root.CFrame
	end

	return nil
end

local function moveCharacterTo(cframe)
	local character = LocalPlayer.Character

	if not character then
		return false
	end

	local root = getRoot(LocalPlayer)

	if not root then
		return false
	end

	pcall(function()
		character:PivotTo(cframe)
	end)

	return true
end

local function autoPickGun()
	if AutoPickBusy then
		return
	end

	if not AutoPickEnabled then
		return
	end

	if not isLocalInnocent() then
		return
	end

	if hasLocalGun() then
		return
	end

	AutoPickBusy = true

	local originalCFrame = getCharacterCFrame()

	if not originalCFrame then
		AutoPickBusy = false
		return
	end

	-- First target = visible dropped gun.
	local targetObject, targetPosition = getNearestGun()

	-- Second target = last known gun holder position.
	if not targetPosition and LastGunDropCFrame then
		targetPosition = LastGunDropCFrame.Position
	end

	if targetPosition then

		local targetCFrame =
			CFrame.new(targetPosition + Vector3.new(0, 2.5, 0))

		-- This uses normal character movement only.
		-- It does NOT force a Backpack Tool or fire exploit-only
		-- touch APIs.
		moveCharacterTo(targetCFrame)

		task.wait(0.35)

		-- Allow the game's normal server pickup/touch system
		-- to process the pickup.
		task.wait(0.35)

		moveCharacterTo(originalCFrame)
	end

	AutoPickBusy = false
end


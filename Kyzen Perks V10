--====================================================--
-- UTILITY
--====================================================--

local function safeDestroy(object)
	if object then
		pcall(function()
			object:Destroy()
		end)
	end
end

local function create(className, properties, parent)
	local object = Instance.new(className)

	for property, value in pairs(properties or {}) do
		pcall(function()
			object[property] = value
		end)
	end

	if parent then
		object.Parent = parent
	end

	return object
end

local function addCorner(object, radius)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, radius or 8)
	corner.Parent = object
	return corner
end

local function addStroke(object, color, thickness, transparency)
	local stroke = Instance.new("UIStroke")
	stroke.Color = color or COLORS.Black
	stroke.Thickness = thickness or 1
	stroke.Transparency = transparency or 0
	stroke.Parent = object
	return stroke
end

local function addGradient(object, color1, color2, rotation)
	local gradient = Instance.new("UIGradient")
	gradient.Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, color1),
		ColorSequenceKeypoint.new(1, color2),
	})
	gradient.Rotation = rotation or 90
	gradient.Parent = object
	return gradient
end

local function tween(object, properties, duration, style, direction)
	if not object then
		return
	end

	local info = TweenInfo.new(
		duration or CONFIG.ANIMATION_TIME,
		style or Enum.EasingStyle.Quart,
		direction or Enum.EasingDirection.Out
	)

	local success, result = pcall(function()
		return TweenService:Create(object, info, properties)
	end)

	if success and result then
		result:Play()
		return result
	end
end

--====================================================--
-- ROLE SYSTEM
--====================================================--

local ROLE_ATTRIBUTE_NAMES = {
	"Role",
	"PlayerRole",
	"CurrentRole",
	"RoleName",
	"GameRole",
	"RoundRole",
	"TeamRole",
}

local function normalizeRole(value)
	if typeof(value) ~= "string" then
		return nil
	end

	local role = string.lower(value)

	role = role:gsub("%s+", "")
	role = role:gsub("_", "")
	role = role:gsub("-", "")

	if role == "murderer"
		or role == "murder"
		or role == "killer" then

		return "Murderer"

	elseif role == "sheriff"
		or role == "cop" then

		return "Sheriff"

	elseif role == "hero" then
		return "Hero"

	elseif role == "innocent"
		or role == "innocents"
		or role == "civilian"
		or role == "citizen" then

		return "Innocent"
	end

	return nil
end

local function getRoleAttribute(player)
	for _, attributeName in ipairs(ROLE_ATTRIBUTE_NAMES) do
		local value = player:GetAttribute(attributeName)

		local role = normalizeRole(value)

		if role then
			return role
		end
	end

	return nil
end

local function objectLooksLikeGun(object)
	if not object then
		return false
	end

	local name = string.lower(object.Name or "")

	local gunWords = {
		"sheriff",
		"gun",
		"pistol",
		"revolver",
		"weapon",
		"blaster",
		"deagle",
	}

	for _, word in ipairs(gunWords) do
		if string.find(name, word, 1, true) then
			return true
		end
	end

	if object:GetAttribute("Gun") == true
		or object:GetAttribute("IsGun") == true
		or object:GetAttribute("SheriffGun") == true then

		return true
	end

	return false
end

local function objectLooksLikeKnife(object)
	if not object then
		return false
	end

	local name = string.lower(object.Name or "")

	local knifeWords = {
		"knife",
		"murderer",
		"blade",
		"dagger",
		"sword",
	}

	for _, word in ipairs(knifeWords) do
		if string.find(name, word, 1, true) then
			return true
		end
	end

	if object:GetAttribute("Knife") == true
		or object:GetAttribute("IsKnife") == true then

		return true
	end

	return false
end

local function playerHasGun(player)
	local character = player.Character

	if character then
		for _, child in ipairs(character:GetChildren()) do
			if child:IsA("Tool") and objectLooksLikeGun(child) then
				return true
			end
		end

		for _, child in ipairs(character:GetChildren()) do
			if objectLooksLikeGun(child) then
				return true
			end
		end
	end

	local backpack = player:FindFirstChildOfClass("Backpack")

	if backpack then
		for _, child in ipairs(backpack:GetChildren()) do
			if child:IsA("Tool") and objectLooksLikeGun(child) then
				return true
			end
		end
	end

	return false
end

local function playerHasKnife(player)
	local character = player.Character

	if not character then
		return false
	end

	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("Tool") and objectLooksLikeKnife(child) then
			return true
		end

		if objectLooksLikeKnife(child) then
			return true
		end
	end

	return false
end

local function detectRole(player)
	if not player then
		return "Innocent", "Fallback"
	end

	-- Server replicated role has highest priority.
	local attributeRole = getRoleAttribute(player)

	if attributeRole then
		if attributeRole == "Sheriff" and RoundFirstSheriffUserId == nil then
			RoundFirstSheriffUserId = player.UserId
		end

		if attributeRole == "Sheriff"
			or attributeRole == "Hero"
			or attributeRole == "Murderer" then

			return attributeRole, "ServerRole"
		end

		return attributeRole, "ServerRole"
	end

	-- Fallback weapon detection.
	local hasKnife = playerHasKnife(player)
	local hasGun = playerHasGun(player)

	if hasKnife then
		return "Murderer", "Weapon"
	end

	if hasGun then

		-- First legitimate gun holder in the round = Sheriff.
		if RoundFirstSheriffUserId == nil then
			RoundFirstSheriffUserId = player.UserId
			RoundGunHolderUserId = player.UserId

			return "Sheriff", "RoundTracker"
		end

		-- Same first holder is still Sheriff.
		if RoundFirstSheriffUserId == player.UserId then
			RoundGunHolderUserId = player.UserId

			return "Sheriff", "RoundTracker"
		end

		-- Gun changed to another player.
		-- That player is Hero, not Sheriff.
		RoundGunHolderUserId = player.UserId

		return "Hero", "RoundTracker"
	end

	return "Innocent", "Fallback"
end

--====================================================--
-- ROUND DETECTION
--====================================================--

local function getRoundSignature()
	local possibleObjects = {
		Workspace,
		ReplicatedStorage,
	}

	for _, root in ipairs(possibleObjects) do

		for _, attributeName in ipairs({
			"RoundId",
			"Round",
			"RoundNumber",
			"GameRound",
			"MatchId",
			"MatchNumber",
			"CurrentRound",
		}) do

			local value = root:GetAttribute(attributeName)

			if value ~= nil then
				return attributeName .. ":" .. tostring(value)
			end
		end
	end

	-- Search common replicated Value objects.
	for _, root in ipairs(possibleObjects) do

		for _, descendant in ipairs(root:GetDescendants()) do

			if descendant:IsA("StringValue")
				or descendant:IsA("IntValue")
				or descendant:IsA("NumberValue") then

				local name = string.lower(descendant.Name)

				if name == "roundid"
					or name == "round"
					or name == "roundnumber"
					or name == "gameround"
					or name == "currentround" then

					return descendant.Name .. ":" .. tostring(descendant.Value)
				end
			end
		end
	end

	return ""
end

local function resetRoundData()
	RoundFirstSheriffUserId = nil
	RoundGunHolderUserId = nil
	LastGunHolderUserId = nil
	LastGunDropCFrame = nil

	table.clear(PreviousRoles)

	for player, data in pairs(ESPData) do
		if data then
			if data.Highlight then
				safeDestroy(data.Highlight)
			end

			if data.Billboard then
				safeDestroy(data.Billboard)
			end

			if data.Folder then
				safeDestroy(data.Folder)
			end
		end

		ESPData[player] = nil
	end
end

local function checkRound()
	local signature = getRoundSignature()

	if signature ~= "" and signature ~= LastRoundSignature then
		LastRoundSignature = signature
		RoundSignature = signature

		resetRoundData()
	end
end


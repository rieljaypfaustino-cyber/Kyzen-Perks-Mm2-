local function setTab(tabName)
	ActiveTab = tabName

	ESPPages = {
		ESP = ESPPage,
		FARM = FarmPage,
		UPDATES = UpdatesPage,
	}

	for name, page in pairs(ESPPages) do
		page.Visible = name == tabName
	end

	local buttons = {
		ESP = ESPTab,
		FARM = FarmTab,
		UPDATES = UpdatesTab,
	}

	for name, button in pairs(buttons) do

		if name == tabName then

			tween(
				button,
				{
					BackgroundColor3 = COLORS.BlueDark,
					TextColor3 = COLORS.White,
				}
			)

		else

			tween(
				button,
				{
					BackgroundColor3 = COLORS.Panel2,
					TextColor3 = COLORS.Light,
				}
			)

		end
	end
end


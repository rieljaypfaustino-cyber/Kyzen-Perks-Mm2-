local function updateESPPlayer(player)
	if player == LocalPlayer then
		return
	end

	if not ESPEnabled then
		clearPlayerESP(player)
		return
	end

	local character = player.Character

	if not character then
		clearPlayerESP(player)
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid or humanoid.Health <= 0 then
		clearPlayerESP(player)
		return
	end

	local root = getRoot(player)

	if not root then
		clearPlayerESP(player)
		return
	end

	local data = ESPData[player]

	if not data
		or not data.Billboard
		or not data.Highlight
		or not data.Folder
		or data.Folder.Parent ~= character then

		createESP(player)

		data = ESPData[player]

		if not data then
			return
		end
	end

	local role, source = detectRole(player)

	local roleColor = getRoleColor(role)

	data.Highlight.Enabled = ESPEnabled

	data.Highlight.FillColor = roleColor
	data.Highlight.OutlineColor = roleColor

	data.Highlight.FillTransparency = 0.78
	data.Highlight.OutlineTransparency = 0

	data.Accent.BackgroundColor3 = roleColor

	data.NameLabel.Text = player.DisplayName

	data.NameLabel.TextColor3 = COLORS.White

	local localRoot = getRoot(LocalPlayer)

	local distanceText = "— studs"

	if localRoot then
		local distance = (root.Position - localRoot.Position).Magnitude
		distanceText = tostring(math.floor(distance + 0.5)) .. " studs"
	end

	data.InfoLabel.Text =
		"@" .. player.Name
		.. "  •  "
		.. role
		.. "  •  "
		.. distanceText

	data.InfoLabel.TextColor3 = roleColor

	local previousRole = PreviousRoles[player.UserId]

	if previousRole ~= role then
		PreviousRoles[player.UserId] = role
	end
end

local function refreshESP()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= LocalPlayer then
			updateESPPlayer(player)
		end
	end

	for player in pairs(ESPData) do
		if not player.Parent
			or player == LocalPlayer then

			clearPlayerESP(player)
		end
	end
end

--====================================================--
-- GUN SCANNER
--====================================================--

local function getWorldPosition(object)
	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object.Position
	end

	if object:IsA("Attachment") then
		return object.WorldPosition
	end

	if object:IsA("Model") then
		local success, pivot = pcall(function()
			return object:GetPivot()
		end)

		if success and pivot then
			return pivot.Position
		end
	end

	local handle = object:FindFirstChild("Handle", true)

	if handle and handle:IsA("BasePart") then
		return handle.Position
	end

	local part = object:FindFirstChildWhichIsA("BasePart", true)

	if part then
		return part.Position
	end

	return nil
end

local function hasGreenParticle(object)
	if not object then
		return false
	end

	for _, descendant in ipairs(object:GetDescendants()) do
		if descendant:IsA("ParticleEmitter")
			or descendant:IsA("Trail")
			or descendant:IsA("Beam") then

			local name = string.lower(descendant.Name)

			if string.find(name, "green", 1, true)
				or string.find(name, "gun", 1, true)
				or string.find(name, "pickup", 1, true)
				or string.find(name, "sheriff", 1, true) then

				return true
			end

			local color = descendant.Color

			if color then
				local keypoints = color.Keypoints

				for _, keypoint in ipairs(keypoints) do
					local c = keypoint.Value

					if c.G > c.R * 1.35
						and c.G > c.B * 1.1 then

						return true
					end
				end
			end
		end
	end

	return false
end

local function isPotentialGunPickup(object)
	if not object then
		return false
	end

	local name = string.lower(object.Name or "")

	local keywords = {
		"sheriff",
		"gun",
		"pistol",
		"revolver",
		"weapon",
		"pickup",
		"dropped",
	}

	for _, word in ipairs(keywords) do
		if string.find(name, word, 1, true) then
			return true
		end
	end

	if object:GetAttribute("Gun") == true
		or object:GetAttribute("IsGun") == true
		or object:GetAttribute("SheriffGun") == true
		or object:GetAttribute("Pickup") == true then

		return true
	end

	if hasGreenParticle(object) then
		return true
	end

	return false
end

local function getNearestGun()
	local localRoot = getRoot(LocalPlayer)

	if not localRoot then
		return nil, nil
	end

	local bestObject = nil
	local bestPosition = nil
	local bestDistance = math.huge

	-- First search obvious dropped objects.
	for _, object in ipairs(Workspace:GetDescendants()) do

		if object ~= LocalPlayer.Character
			and isPotentialGunPickup(object) then

			local position = getWorldPosition(object)

			if position then
				local distance =
					(position - localRoot.Position).Magnitude

				if distance < bestDistance
					and distance <= CONFIG.GUN_DISTANCE then

					bestObject = object
					bestPosition = position
					bestDistance = distance
				end
			end
		end
	end

	-- Prefer objects with green pickup particles.
	for _, object in ipairs(Workspace:GetDescendants()) do

		if hasGreenParticle(object) then

			local position = getWorldPosition(object)

			if position then
				local distance =
					(position - localRoot.Position).Magnitude

				if distance < bestDistance
					and distance <= CONFIG.GUN_DISTANCE then

					bestObject = object
					bestPosition = position
					bestDistance = distance
				end
			end
		end
	end

	return bestObject, bestPosition
end


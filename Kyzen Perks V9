local function markHeroIfValid()

	if not hasGun(LocalPlayer) then
		return
	end

	local serverRole =
		getRoleAttribute(
			LocalPlayer
		)

	if serverRole == "Sheriff"
		or serverRole == "Murderer"
		or serverRole == "Hero"
	then

		if serverRole == "Hero" then
			PreviousRoles[
				LocalPlayer
			] = "Hero"
		end

		return
	end

	if FirstSheriff
		and not FirstSheriffAlive
	then

		PreviousRoles[
			LocalPlayer
		] = "Hero"

		return
	end

	if LastGunOwner
		and LastGunOwner
			~= LocalPlayer
	then

		PreviousRoles[
			LocalPlayer
		] = "Hero"
	end
end

--------------------------------------------------------
-- AUTO PICK
--------------------------------------------------------

local function autoPick()

	if not AutoPickEnabled then
		return
	end

	if AutoPickBusy then
		return
	end

	if getRole(
		LocalPlayer
	) ~= "Innocent"
	then

		return
	end

	local object
	local part

	if EligibleHeroGunPosition then

		object, part =
			findGunNear(
				EligibleHeroGunPosition
			)
	end

	if not object then

		object, part =
			findDroppedGun()
	end

	if not object
		or not part
	then

		return
	end

	local character =
		LocalPlayer.Character

	local root =
		getRoot(character)

	if not root then
		return
	end

	AutoPickBusy = true

	local oldCFrame =
		root.CFrame

	----------------------------------------------------
	-- MOVE TO GUN
	----------------------------------------------------

	pcall(function()

		root.CFrame =
			CFrame.new(
				part.Position
					+ Vector3.new(
						0,
						2,
						0
					)
			)

	end)

	----------------------------------------------------
	-- NORMAL TOUCH WINDOW
	----------------------------------------------------

	local start =
		os.clock()

	while os.clock() - start
		< 1.25
	do

		if hasGun(
			LocalPlayer
		) then

			break
		end

		task.wait(0.05)

		if root
			and root.Parent
			and part
			and part.Parent
		then

			if (
				root.Position
				- part.Position
			).Magnitude > 7
			then

				pcall(function()

					root.CFrame =
						CFrame.new(
							part.Position
								+ Vector3.new(
									0,
									2,
									0
								)
						)

				end)
			end
		end
	end

	task.wait(0.12)

	----------------------------------------------------
	-- HERO FALLBACK MEMORY
	----------------------------------------------------

	if hasGun(
		LocalPlayer
	) then

		markHeroIfValid()
	end

	----------------------------------------------------
	-- RETURN
	----------------------------------------------------

	if root
		and root.Parent
	then

		pcall(function()
			root.CFrame =
				oldCFrame
		end)
	end

	AutoPickBusy = false
end


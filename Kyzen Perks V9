local function refreshPlayerList()

	for _, child in ipairs(
		ESPList:GetChildren()
	) do

		if child:IsA(
			"TextButton"
		) then

			child:Destroy()
		end
	end

	local players =
		Players:GetPlayers()

	table.sort(
		players,
		function(a, b)

			return a.Name
				< b.Name
		end
	)

	for _, player in ipairs(
		players
	) do

		if player ~= LocalPlayer then

			local role =
				getRole(player)

			local color =
				ROLE_COLORS[role]
				or ROLE_COLORS.Innocent

			local item =
				Instance.new(
					"TextButton"
				)

			item.Size =
				UDim2.new(
					1,
					-10,
					0,
					39
				)

			item.BackgroundColor3 =
				PANEL2

			item.Text =
				player.DisplayName
				.. "    "
				.. role

			item.TextColor3 =
				color

			item.Font =
				Enum.Font.GothamBold

			item.TextSize =
				9

			item.AutoButtonColor =
				false

			item.Parent =
				ESPList

			corner(
				item,
				7
			)

			stroke(
				item,
				STROKE,
				1.5
			)
		end
	end
end


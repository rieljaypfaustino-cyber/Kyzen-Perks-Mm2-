--------------------------------------------------------
-- LOCAL HERO TRACKER
--------------------------------------------------------

task.spawn(
	function()

		local oldRole = nil

		while ScreenGui.Parent do

			local role =
				getRole(
					LocalPlayer
				)

			local serverRole =
				getRoleAttribute(
					LocalPlayer
				)

			if serverRole == "Hero" then

				PreviousRoles[
					LocalPlayer
				] = "Hero"

			elseif hasGun(
				LocalPlayer
			)
				and serverRole ~= "Sheriff"
				and serverRole ~= "Murderer"
				and FirstSheriff
				and not FirstSheriffAlive
			then

				PreviousRoles[
					LocalPlayer
				] = "Hero"
			end

			if role ~= oldRole then

				if oldRole ~= nil then

					if role == "Hero" then

						notify(
							"HERO",
							"You are now detected as Hero.",
							Color3.fromRGB(
								255,
								215,
								55
							),
							2.5
						)

					elseif role == "Sheriff" then

						notify(
							"SHERIFF",
							"You are detected as Sheriff.",
							BLUE,
							2.5
						)
					end
				end

				oldRole =
					role
			end

			task.wait(
				0.25
			)
		end
	end
)


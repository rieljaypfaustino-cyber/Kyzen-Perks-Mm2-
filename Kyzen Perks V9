--------------------------------------------------------
-- UTILITY
--------------------------------------------------------

local function contains(text, words)

	text = string.lower(
		tostring(text or "")
	)

	for _, word in ipairs(words) do

		if string.find(
			text,
			string.lower(word),
			1,
			true
		) then

			return true
		end
	end

	return false
end

local function corner(parent, radius)

	local c = Instance.new("UICorner")

	c.CornerRadius =
		UDim.new(0, radius)

	c.Parent = parent

	return c
end

local function stroke(parent, color, thickness)

	local s = Instance.new("UIStroke")

	s.Color = color
	s.Thickness = thickness

	s.ApplyStrokeMode =
		Enum.ApplyStrokeMode.Border

	s.Parent = parent

	return s
end

local function gradient(parent)

	local g = Instance.new("UIGradient")

	g.Color =
		ColorSequence.new({

			ColorSequenceKeypoint.new(
				0,
				RED
			),

			ColorSequenceKeypoint.new(
				0.5,
				Color3.fromRGB(
					100,
					65,
					145
				)
			),

			ColorSequenceKeypoint.new(
				1,
				BLUE
			),
		})

	g.Rotation = 25

	g.Parent = parent

	return g
end

local function getRoot(character)

	if not character then
		return nil
	end

	return character:FindFirstChild(
		"HumanoidRootPart"
	)
		or character:FindFirstChild(
			"UpperTorso"
		)
		or character:FindFirstChild(
			"Torso"
		)
end

local function getHumanoid(character)

	if not character then
		return nil
	end

	return character:FindFirstChildOfClass(
		"Humanoid"
	)
end

local function getCharacterPosition(player)

	if not player.Character then
		return nil
	end

	local root =
		getRoot(player.Character)

	return root and root.Position
end

--------------------------------------------------------
-- ROLE NORMALIZATION
--------------------------------------------------------

local function normalizeRole(role)

	if role == nil then
		return nil
	end

	role =
		string.lower(
			tostring(role)
		)

	if role == "murder"
		or role == "murderer"
		or role == "killer"
	then
		return "Murderer"
	end

	if role == "sheriff"
		or role == "cop"
	then
		return "Sheriff"
	end

	if role == "hero" then
		return "Hero"
	end

	if role == "innocent"
		or role == "civilian"
		or role == "survivor"
	then
		return "Innocent"
	end

	return nil
end

--------------------------------------------------------
-- SERVER ROLE ATTRIBUTE
--------------------------------------------------------

local function getRoleAttribute(player)

	if not player then
		return nil
	end

	for _, attribute in ipairs(
		ROLE_ATTRIBUTES
	) do

		local value =
			player:GetAttribute(attribute)

		local role =
			normalizeRole(value)

		if role then
			return role
		end
	end

	if player.Character then

		for _, attribute in ipairs(
			ROLE_ATTRIBUTES
		) do

			local value =
				player.Character:GetAttribute(
					attribute
				)

			local role =
				normalizeRole(value)

			if role then
				return role
			end
		end
	end

	return nil
end

--------------------------------------------------------
-- TOOL DETECTION
--------------------------------------------------------

local function findTool(container, words)

	if not container then
		return nil
	end

	for _, object in ipairs(
		container:GetChildren()
	) do

		if object:IsA("Tool")
			and contains(
				object.Name,
				words
			)
		then

			return object
		end
	end

	return nil
end

local function hasKnife(player)

	if not player then
		return false
	end

	local backpack =
		player:FindFirstChildOfClass(
			"Backpack"
		)

	if backpack
		and findTool(
			backpack,
			KNIFE_WORDS
		)
	then
		return true
	end

	if player.Character
		and findTool(
			player.Character,
			KNIFE_WORDS
		)
	then
		return true
	end

	return false
end

local function hasGun(player)

	if not player then
		return false
	end

	local backpack =
		player:FindFirstChildOfClass(
			"Backpack"
		)

	if backpack
		and findTool(
			backpack,
			GUN_WORDS
		)
	then
		return true
	end

	if player.Character
		and findTool(
			player.Character,
			GUN_WORDS
		)
	then
		return true
	end

	return false
end

--------------------------------------------------------
-- ROLE DETECTION
--------------------------------------------------------

local function getRole(player)

	if not player then
		return "Innocent"
	end

	----------------------------------------------------
	-- SERVER ROLE
	----------------------------------------------------

	local serverRole =
		getRoleAttribute(player)

	if serverRole then

		if serverRole == "Hero" then
			return "Hero"
		end

		if serverRole == "Murderer" then
			return "Murderer"
		end

		if serverRole == "Sheriff" then
			return "Sheriff"
		end

		if serverRole == "Innocent"
			and PreviousRoles[player]
				~= "Hero"
		then

			return "Innocent"
		end
	end

	----------------------------------------------------
	-- HERO MEMORY
	----------------------------------------------------

	if PreviousRoles[player] == "Hero" then
		return "Hero"
	end

	----------------------------------------------------
	-- MURDERER
	----------------------------------------------------

	if hasKnife(player) then
		return "Murderer"
	end

	----------------------------------------------------
	-- FIRST SHERIFF
	----------------------------------------------------

	if player == FirstSheriff
		and FirstSheriffAlive
		and not FirstSheriffLeft
	then

		return "Sheriff"
	end

	----------------------------------------------------
	-- HERO GUN HOLDER
	----------------------------------------------------

	if PreviousRoles[player] == "Hero" then
		return "Hero"
	end

	----------------------------------------------------
	-- UNKNOWN GUN
	----------------------------------------------------

	if hasGun(player) then

		if player == FirstSheriff then
			return "Sheriff"
		end

		return "Sheriff"
	end

	return "Innocent"
end


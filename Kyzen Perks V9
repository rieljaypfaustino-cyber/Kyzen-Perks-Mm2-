local function getAttribute(
	container,
	attributes
)

	if not container then
		return nil
	end

	for _, name in ipairs(attributes) do

		local value =
			container:GetAttribute(name)

		if value ~= nil then
			return value
		end
	end

	return nil
end

local function getRoundSignature()

	local round =
		getAttribute(
			Workspace,
			ROUND_ATTRIBUTES
		)

	if round == nil then

		round =
			getAttribute(
				ReplicatedStorage,
				ROUND_ATTRIBUTES
			)
	end

	local state =
		getAttribute(
			Workspace,
			STATE_ATTRIBUTES
		)

	if state == nil then

		state =
			getAttribute(
				ReplicatedStorage,
				STATE_ATTRIBUTES
			)
	end

	return tostring(
		round or "NO_ROUND"
	)
		.. "|"
		.. tostring(
			state or "NO_STATE"
		)
end

local function resetRound()

	FirstSheriff = nil
	FirstSheriffUserId = nil

	FirstSheriffAlive = false
	FirstSheriffLeft = false

	LastGunOwner = nil
	LastGunOwnerPosition = nil

	EligibleHeroGunPosition = nil

	table.clear(
		PreviousRoles
	)
end


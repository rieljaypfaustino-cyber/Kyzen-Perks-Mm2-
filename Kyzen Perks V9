local function findFirstSheriff()

	if FirstSheriff then
		return
	end

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if getRoleAttribute(player)
			== "Sheriff"
		then

			FirstSheriff = player
			FirstSheriffUserId =
				player.UserId

			FirstSheriffAlive = true

			return
		end
	end

	----------------------------------------------------
	-- FALLBACK
	----------------------------------------------------

	for _, player in ipairs(
		Players:GetPlayers()
	) do

		if hasGun(player)
			and not hasKnife(player)
		then

			FirstSheriff = player
			FirstSheriffUserId =
				player.UserId

			FirstSheriffAlive = true

			return
		end
	end
end

local function sheriffDied(player)

	if player ~= FirstSheriff then
		return
	end

	FirstSheriffAlive = false

	LastGunOwner = player

	LastGunOwnerPosition =
		getCharacterPosition(player)

	EligibleHeroGunPosition =
		LastGunOwnerPosition
end


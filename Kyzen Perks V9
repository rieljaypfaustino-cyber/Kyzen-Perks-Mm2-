local function updateESP(player)

	if player == LocalPlayer then
		return
	end

	if not ESPEnabled then
		removeESP(player)
		return
	end

	local character =
		player.Character

	local root =
		getRoot(character)

	if not character
		or not root
	then

		removeESP(player)
		return
	end

	local role =
		getRole(player)

	local data =
		ESPData[player]

	if not data
		or data.Role ~= role
	then

		createESP(player)

		data =
			ESPData[player]
	end

	if not data then
		return
	end

	local color =
		ROLE_COLORS[role]
		or ROLE_COLORS.Innocent

	data.Role =
		role

	data.Highlight.FillColor =
		color

	data.Highlight.OutlineColor =
		color

	data.RoleLabel.Text =
		role

	data.RoleLabel.TextColor3 =
		color

	local localPosition =
		getCharacterPosition(
			LocalPlayer
		)

	if localPosition then

		local studs =
			(
				root.Position
				- localPosition
			).Magnitude

		data.Distance.Text =
			string.format(
				"%d studs",
				math.floor(studs)
			)
	end
end

local function clearESP()

	for player in pairs(
		ESPData
	) do

		removeESP(player)
	end

	table.clear(
		ESPData
	)
end


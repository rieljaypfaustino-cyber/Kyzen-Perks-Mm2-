local function selectTab(tab)

	CurrentTab =
		tab

	local pages = {
		ESP = ESPPage,
		FARM = FarmPage,
		UPDATES = UpdatesPage,
	}

	for name, page in pairs(
		pages
	) do

		page.Visible =
			name == tab
	end

	----------------------------------------------------
	-- RESET BUTTON LOOK
	----------------------------------------------------

	local tabs = {
		ESP = {
			button = ESPTab,
			line = ESPLine,
			color = RED,
		},

		FARM = {
			button = FarmTab,
			line = FarmLine,
			color = BLUE,
		},

		UPDATES = {
			button = UpdatesTab,
			line = UpdatesLine,
			color = RED,
		},
	}

	for name, data in pairs(
		tabs
	) do

		if name == tab then

			data.button.BackgroundColor3 =
				data.color

			data.button.TextColor3 =
				WHITE

			data.line.BackgroundTransparency =
				0

		else

			data.button.BackgroundColor3 =
				PANEL2

			data.button.TextColor3 =
				GREY

			data.line.BackgroundTransparency =
				1
		end
	end

	----------------------------------------------------
	-- PAGE ENTRY ANIMATION
	----------------------------------------------------

	local page =
		pages[tab]

	if page then

		page.Position =
			UDim2.fromOffset(
				8,
				0
			)

		page.GroupTransparency = nil

		TweenService:Create(
			page,
			TweenInfo.new(
				0.2,
				Enum.EasingStyle.Quint,
				Enum.EasingDirection.Out
			),
			{
				Position =
					UDim2.fromOffset(
						0,
						0
					)
			}
		):Play()
	end
end


local function connectPlayer(player)

	if player == LocalPlayer then
		return
	end

	player.CharacterAdded:Connect(
		function(character)

			local humanoid =
				character:WaitForChild(
					"Humanoid",
					5
				)

			if humanoid then

				humanoid.Died:Connect(
					function()

						if player
							== FirstSheriff
						then

							sheriffDied(
								player
							)

						elseif PreviousRoles[
							player
						] == "Hero"
						then

							LastGunOwner =
								player

							LastGunOwnerPosition =
								getCharacterPosition(
									player
								)
						end
					end
				)
			end
		end
	)

	if player.Character then

		local humanoid =
			getHumanoid(
				player.Character
			)

		if humanoid then

			humanoid.Died:Connect(
				function()

					if player
						== FirstSheriff
					then

						sheriffDied(
							player
						)
					end
				end
			)
		end
	end
end

for _, player in ipairs(
	Players:GetPlayers()
) do

	connectPlayer(player)
end

Players.PlayerAdded:Connect(
	function(player)

		connectPlayer(player)

		task.delay(
			0.5,
			findFirstSheriff
		)
	end
)

Players.PlayerRemoving:Connect(
	function(player)

		if player == FirstSheriff then

			FirstSheriffLeft =
				true

			FirstSheriffAlive =
				false

			LastGunOwner =
				player

			LastGunOwnerPosition =
				getCharacterPosition(
					player
				)

			EligibleHeroGunPosition =
				LastGunOwnerPosition
		end

		PreviousRoles[player] =
			nil

		if ESPData[player] then

			local data =
				ESPData[player]

			if data.Highlight then
				data.Highlight:Destroy()
			end

			if data.Billboard then
				data.Billboard:Destroy()
			end

			ESPData[player] =
				nil
		end
	end
)

--------------------------------------------------------
-- DROPPED GUN DETECTION
--------------------------------------------------------

local function greenParticle(object)

	if not object then
		return false
	end

	for _, descendant in ipairs(
		object:GetDescendants()
	) do

		if descendant:IsA(
			"ParticleEmitter"
		) then

			local sequence =
				descendant.Color

			if sequence then

				for _, point in ipairs(
					sequence.Keypoints
				) do

					local c =
						point.Value

					if c.G > c.R * 1.2
						and c.G > c.B * 1.05
					then

						return true
					end
				end
			end
		end
	end

	return false
end

local function gunAttribute(object)

	if not object then
		return false
	end

	local attributes = {
		"Gun",
		"IsGun",
		"SheriffGun",
		"Weapon",
		"IsWeapon",
		"DroppedGun",
		"HeroGun",
	}

	for _, attribute in ipairs(
		attributes
	) do

		if object:GetAttribute(
			attribute
		) == true
		then

			return true
		end
	end

	return false
end

local function looksLikeGun(object)

	if not object then
		return false
	end

	local name =
		string.lower(
			object.Name
		)

	if contains(
		name,
		GUN_WORDS
	) then

		return true
	end

	if gunAttribute(object) then
		return true
	end

	if greenParticle(object) then

		if string.find(
			name,
			"gun",
			1,
			true
		)
		or string.find(
			name,
			"drop",
			1,
			true
		)
		or string.find(
			name,
			"sheriff",
			1,
			true
		)
		or string.find(
			name,
			"weapon",
			1,
			true
		)
		then

			return true
		end
	end

	return false
end

local function getTouchPart(object)

	if not object then
		return nil
	end

	if object:IsA("Tool") then

		local handle =
			object:FindFirstChild(
				"Handle"
			)

		if handle
			and handle:IsA(
				"BasePart"
			)
		then

			return handle
		end
	end

	if object:IsA(
		"BasePart"
	) then

		return object
	end

	if object:IsA("Model") then

		local handle =
			object:FindFirstChild(
				"Handle",
				true
			)

		if handle
			and handle:IsA(
				"BasePart"
			)
		then

			return handle
		end

		if object.PrimaryPart then
			return object.PrimaryPart
		end

		for _, descendant in ipairs(
			object:GetDescendants()
		) do

			if descendant:IsA(
				"BasePart"
			) then

				return descendant
			end
		end
	end

	return nil
end

local function findDroppedGun()

	local localPosition =
		getCharacterPosition(
			LocalPlayer
		)

	if not localPosition then
		return nil, nil
	end

	local closestObject
	local closestPart

	local closestDistance =
		math.huge

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		if looksLikeGun(object) then

			local part =
				getTouchPart(object)

			if part then

				local distance =
					(
						part.Position
						- localPosition
					).Magnitude

				if distance
					< closestDistance
					and distance < 5000
				then

					closestDistance =
						distance

					closestObject =
						object

					closestPart =
						part
				end
			end
		end
	end

	return closestObject, closestPart
end

local function findGunNear(position)

	if not position then
		return nil, nil
	end

	local closestObject
	local closestPart

	local closestDistance =
		math.huge

	for _, object in ipairs(
		Workspace:GetDescendants()
	) do

		if looksLikeGun(object) then

			local part =
				getTouchPart(object)

			if part then

				local distance =
					(
						part.Position
						- position
					).Magnitude

				if distance
					< closestDistance
					and distance <= 100
				then

					closestDistance =
						distance

					closestObject =
						object

					closestPart =
						part
				end
			end
		end
	end

	return closestObject, closestPart
end


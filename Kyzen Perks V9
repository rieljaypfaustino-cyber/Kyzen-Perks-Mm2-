				getRoundSignature()

			if not CurrentRoundSignature then

				CurrentRoundSignature =
					signature

				findFirstSheriff()

			elseif signature
				~= CurrentRoundSignature
			then

				CurrentRoundSignature =
					signature

				resetRound()

				clearESP()

				task.wait(

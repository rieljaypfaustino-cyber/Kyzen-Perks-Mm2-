--------------------------------------------------------
-- UTILITY
--------------------------------------------------------

local function destroy(object)

	if object then

		pcall(function()
			object:Destroy()
		end)

	end

end

--------------------------------------------------------

local function textLower(value)

	return string.lower(tostring(value or ""))

end

--------------------------------------------------------

local function contains(text, list)

	text = textLower(text)

	for _, word in ipairs(list) do

		if string.find(text, textLower(word), 1, true) then
			return true
		end

	end

	return false

end

--------------------------------------------------------
-- CHARACTER
--------------------------------------------------------

local function getCharacter(player)

	return player.Character

end

--------------------------------------------------------

local function getRoot(player)

	local character = getCharacter(player)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")

end

--------------------------------------------------------
-- ROLE ATTRIBUTE
--------------------------------------------------------

local function readRoleAttribute(player)

	for _, attribute in ipairs(CONFIG.ROLE_ATTRIBUTES) do

		local value = player:GetAttribute(attribute)

		if value ~= nil then

			local role = textLower(value)

			if string.find(role, "murder") then
				return "Murderer"
			end

			if string.find(role, "sheriff") then
				return "Sheriff"
			end

			if string.find(role, "hero") then
				return "Hero"
			end

			if string.find(role, "innocent") then
				return "Innocent"
			end

		end

	end

	return nil

end

--------------------------------------------------------
-- ROLE FROM TEAM
--------------------------------------------------------

local function readTeamRole(player)

	local team = player.Team

	if not team then
		return nil
	end

	local teamName = textLower(team.Name)

	if string.find(teamName, "murder") then
		return "Murderer"
	end

	if string.find(teamName, "sheriff") then
		return "Sheriff"
	end

	if string.find(teamName, "hero") then
		return "Hero"
	end

	if string.find(teamName, "innocent") then
		return "Innocent"
	end

	return nil

end

--------------------------------------------------------
-- PLAYER TOOLS
--------------------------------------------------------

local function getTools(player)

	local result = {}

	local backpack = player:FindFirstChildOfClass("Backpack")

	if backpack then

		for _, object in ipairs(backpack:GetChildren()) do

			if object:IsA("Tool") then
				table.insert(result, object)
			end

		end

	end

	local character = player.Character

	if character then

		for _, object in ipairs(character:GetChildren()) do

			if object:IsA("Tool") then
				table.insert(result, object)
			end

		end

	end

	return result

end

--------------------------------------------------------
-- KNIFE
--------------------------------------------------------

local function hasKnife(player)

	for _, tool in ipairs(getTools(player)) do

		if contains(tool.Name, CONFIG.KNIFE_WORDS) then
			return true
		end

	end

	return false

end

--------------------------------------------------------
-- GUN
--------------------------------------------------------

local function hasGun(player)

	for _, tool in ipairs(getTools(player)) do

		if contains(tool.Name, CONFIG.GUN_WORDS) then
			return true
		end

		for _, attributeName in ipairs({
			"WeaponType",
			"ItemType",
			"Type",
			"Role",
		}) do

			local value = tool:GetAttribute(attributeName)

			if value and contains(value, CONFIG.GUN_WORDS) then
				return true
			end

		end

	end

	return false

end

--------------------------------------------------------
-- ROLE DETECTOR
--------------------------------------------------------

local function getRole(player)

	----------------------------------------------------
	-- BEST SOURCE: SERVER ATTRIBUTE
	----------------------------------------------------

	local attributeRole = readRoleAttribute(player)

	if attributeRole then

		PreviousRoles[player] = attributeRole

		return attributeRole

	end

	----------------------------------------------------
	-- TEAM
	----------------------------------------------------

	local teamRole = readTeamRole(player)

	if teamRole then

		PreviousRoles[player] = teamRole

		return teamRole

	end

	----------------------------------------------------
	-- KNIFE
	----------------------------------------------------

	if hasKnife(player) then

		PreviousRoles[player] = "Murderer"

		return "Murderer"

	end

	----------------------------------------------------
	-- GUN
	----------------------------------------------------

	if hasGun(player) then

		local previous = PreviousRoles[player]

		if previous == "Innocent" then

			PreviousRoles[player] = "Hero"

			return "Hero"

		end

		PreviousRoles[player] = "Sheriff"

		return "Sheriff"

	end

	----------------------------------------------------
	-- DEFAULT
	----------------------------------------------------

	if not PreviousRoles[player] then
		PreviousRoles[player] = "Innocent"
	end

	return PreviousRoles[player]

end

--------------------------------------------------------
-- ROLE COLOR
--------------------------------------------------------

local function roleColor(role)

	if role == "Murderer" then
		return RED
	end

	if role == "Sheriff" then
		return BLUE
	end

	if role == "Hero" then
		return YELLOW
	end

	return GREEN

end


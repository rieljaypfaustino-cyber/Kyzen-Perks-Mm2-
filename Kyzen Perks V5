	player.CharacterAdded:Connect(function()

		removeESP(player)

		task.wait(0.25)

		updateESP(player)

	end)

	player.CharacterRemoving:Connect(function()

		removeESP(player)

	end)

	for _, attribute in ipairs(
		CONFIG.ROLE_ATTRIBUTES
	) do

		player:GetAttributeChangedSignal(
			attribute
		):Connect(function()

			removeESP(player)

			task.wait()

			updateESP(player)

		end)

	end

	player:GetPropertyChangedSignal(
		"Team"
	):Connect(function()

		removeESP(player)

	end)

end


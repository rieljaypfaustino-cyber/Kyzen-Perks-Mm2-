--------------------------------------------------------

local function clearESP()

	for player in pairs(ESPObjects) do
		removeESP(player)
	end

end

--------------------------------------------------------
-- ROUND DETECTION
--------------------------------------------------------

local function detectRound()

	for _, name in ipairs({
		"RoundId",
		"Round",
		"RoundNumber",
		"CurrentRound",
		"GameRound",
	}) do

		local value = Workspace:GetAttribute(name)

		if value ~= nil then

			local signature =
				name .. ":" .. tostring(value)

			if CurrentRound == nil then

				CurrentRound = signature

			elseif CurrentRound ~= signature then

				CurrentRound = signature

				PreviousRoles = {}

				clearESP()

			end

			return

		end

	end

end

--------------------------------------------------------
-- DROPPED GUN CHECK
--------------------------------------------------------

local function objectLooksLikeGun(object)

	if not object then
		return false
	end

	----------------------------------------------------
	-- NAME
	----------------------------------------------------

	if contains(object.Name, CONFIG.GUN_WORDS) then
		return true
	end

	----------------------------------------------------
	-- ATTRIBUTES
	----------------------------------------------------

	for _, attribute in ipairs({
		"WeaponType",
		"ItemType",
		"Weapon",
		"Type",
		"Role",
		"Gun",
	}) do

		local value = object:GetAttribute(attribute)

		if value ~= nil then

			local str = textLower(value)

			if contains(str, CONFIG.GUN_WORDS)
				or string.find(str, "sheriff", 1, true)
				or string.find(str, "hero", 1, true) then

				return true

			end

		end

	end

	----------------------------------------------------
	-- DESCENDANT NAMES
	----------------------------------------------------

	for _, descendant in ipairs(object:GetDescendants()) do

		if contains(descendant.Name, CONFIG.GUN_WORDS) then
			return true
		end

	end

	return false

end

--------------------------------------------------------
-- GREEN PARTICLE DETECTION
--------------------------------------------------------

local function hasGreenParticle(object)

	for _, descendant in ipairs(object:GetDescendants()) do

		if descendant:IsA("ParticleEmitter") then

			local colorSequence = descendant.Color

			if colorSequence then

				for _, keypoint in ipairs(
					colorSequence.Keypoints
				) do

					local color = keypoint.Value

					if color.G > 0.45
						and color.G > color.R * 1.25
						and color.G > color.B * 1.1 then

						return true

					end

				end

			end

		end

	end

	return false

end

--------------------------------------------------------
-- GET PART FROM OBJECT
--------------------------------------------------------

local function getObjectPart(object)

	if not object then
		return nil
	end

	if object:IsA("BasePart") then
		return object
	end

	if object:IsA("Tool") then

		local handle = object:FindFirstChild("Handle")

		if handle and handle:IsA("BasePart") then
			return handle
		end

	end

	return object:FindFirstChildWhichIsA(
		"BasePart",
		true
	)

end

--------------------------------------------------------
-- DROPPED GUN VALIDATION
--------------------------------------------------------

local function isDroppedGun(object)

	if not object then
		return false
	end

	----------------------------------------------------
	-- DO NOT DETECT PLAYER-OWNED TOOL
	----------------------------------------------------

	for _, player in ipairs(Players:GetPlayers()) do

		local character = player.Character

		if character
			and object:IsDescendantOf(character) then

			return false

		end

		local backpack =
			player:FindFirstChildOfClass("Backpack")

		if backpack
			and object:IsDescendantOf(backpack) then

			return false

		end

	end

	----------------------------------------------------
	-- GUN NAME / ATTRIBUTES
	----------------------------------------------------

	if objectLooksLikeGun(object) then

		return true

	end

	----------------------------------------------------
	-- GREEN PARTICLE FALLBACK
	----------------------------------------------------

	if hasGreenParticle(object) then

		local name = textLower(object.Name)

		if string.find(name, "drop", 1, true)
			or string.find(name, "gun", 1, true)
			or string.find(name, "weapon", 1, true)
			or string.find(name, "sheriff", 1, true) then

			return true

		end

	end

	return false

end

--------------------------------------------------------
-- FIND DROPPED GUN
--------------------------------------------------------

local function findDroppedGun()

	local root = getRoot(LocalPlayer)

	if not root then
		return nil
	end

	local best = nil

	local bestDistance = CONFIG.GUN_MAX_DISTANCE

	----------------------------------------------------
	-- SEARCH DESCENDANTS
	----------------------------------------------------

	for _, object in ipairs(Workspace:GetDescendants()) do

		------------------------------------------------
		-- TOOL
		------------------------------------------------

		if object:IsA("Tool") then

			if isDroppedGun(object) then

				local part = getObjectPart(object)

				if part then

					local distance =
						(root.Position - part.Position).Magnitude

					if distance < bestDistance then

						bestDistance = distance

						best = {

							Object = object,
							Part = part,

						}

					end

				end

			end

		end

	end

	----------------------------------------------------
	-- MODEL / PART FALLBACK
	----------------------------------------------------

	if not best then

		for _, object in ipairs(
			Workspace:GetChildren()
		) do

			if object:IsA("Model")
				or object:IsA("BasePart") then

				if isDroppedGun(object) then

					local part =
						getObjectPart(object)

					if part then

						local distance =
							(root.Position - part.Position).Magnitude

						if distance < bestDistance then

							bestDistance = distance

							best = {

								Object = object,
								Part = part,

							}

						end

					end

				end

			end

		end

	end

	return best

end

--------------------------------------------------------
-- CHECK IF GUN ENTERED BACKPACK
--------------------------------------------------------

local function findNewGunInBackpack(beforeTools)

	local backpack =
		LocalPlayer:FindFirstChildOfClass("Backpack")

	if not backpack then
		return nil
	end

	for _, tool in ipairs(backpack:GetChildren()) do

		if tool:IsA("Tool") then

			if objectLooksLikeGun(tool) then

				if not beforeTools[tool] then
					return tool
				end

			end

		end

	end

	return nil

end

--------------------------------------------------------
-- SAVE TOOLS
--------------------------------------------------------

local function snapshotBackpack()

	local result = {}

	local backpack =
		LocalPlayer:FindFirstChildOfClass("Backpack")

	if backpack then

		for _, object in ipairs(backpack:GetChildren()) do

			if object:IsA("Tool") then
				result[object] = true
			end

		end

	end

	return result

end

--------------------------------------------------------
-- AUTO PICK
--------------------------------------------------------

local function autoPickGun()

	if not AutoPickEnabled then
		return
	end

	if AutoPickBusy then
		return
	end

	----------------------------------------------------
	-- MUST BE INNOCENT
	----------------------------------------------------

	local myRole = getRole(LocalPlayer)

	if myRole ~= "Innocent" then

		return

	end

	----------------------------------------------------
	-- CHARACTER
	----------------------------------------------------

	local character = LocalPlayer.Character

	local humanoid = character
		and character:FindFirstChildOfClass("Humanoid")

	local root = getRoot(LocalPlayer)

	if not character
		or not humanoid
		or humanoid.Health <= 0
		or not root then

		return

	end

	----------------------------------------------------
	-- FIND GUN
	----------------------------------------------------

	local dropped = findDroppedGun()

	if not dropped then
		return
	end

	if not dropped.Part then
		return
	end

	----------------------------------------------------
	-- BUSY
	----------------------------------------------------

	AutoPickBusy = true

	----------------------------------------------------
	-- SAVE POSITION
	----------------------------------------------------

	local oldCFrame = root.CFrame

	local beforeTools =
		snapshotBackpack()

	----------------------------------------------------
	-- TELEPORT
	----------------------------------------------------

	local targetPosition =
		dropped.Part.Position
		+ CONFIG.TELEPORT_OFFSET

	root.CFrame =
		CFrame.new(
			targetPosition,
			targetPosition + root.CFrame.LookVector
		)

	----------------------------------------------------
	-- SMALL PHYSICS WAIT
	----------------------------------------------------

	task.wait(0.12)

	----------------------------------------------------
	-- TOUCH PICKUP WINDOW
	----------------------------------------------------

	local deadline =
		os.clock()
		+ CONFIG.PICKUP_WAIT

	local pickedUp = false

	while os.clock() < deadline do

		------------------------------------------------
		-- CHECK BACKPACK
		------------------------------------------------

		local newGun =
			findNewGunInBackpack(beforeTools)

		if newGun then

			pickedUp = true

			break

		end

		------------------------------------------------
		-- IF OBJECT DISAPPEARED, GIVE SERVER TIME
		------------------------------------------------

		if not dropped.Object
			or not dropped.Object.Parent then

			task.wait(0.15)

			local newGun2 =
				findNewGunInBackpack(beforeTools)

			if newGun2 then
				pickedUp = true
			end

			break

		end

		task.wait(0.05)

	end

	----------------------------------------------------
	-- RETURN
	----------------------------------------------------

	task.wait(CONFIG.RETURN_DELAY)

	local currentRoot = getRoot(LocalPlayer)

	if currentRoot then

		currentRoot.CFrame = oldCFrame

	end

	----------------------------------------------------
	-- RELEASE
	----------------------------------------------------

	AutoPickBusy = false

	----------------------------------------------------
	-- RESULT
	----------------------------------------------------

	if pickedUp then

		PreviousRoles[LocalPlayer] = "Hero"

	end

end


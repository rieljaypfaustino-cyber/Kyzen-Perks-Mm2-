-- FIND DROPPED GUN
--------------------------------------------------------

local function isPossibleGun(object)

	if not object then
		return false
	end

	local name = lower(object.Name)

	if containsWord(name, CONFIG.GUN_WORDS) then
		return true
	end

	----------------------------------------------------
	-- Check attributes
	----------------------------------------------------

	for _, attributeName in ipairs({
		"Role",
		"WeaponType",
		"ItemType",
		"Type",
		"Weapon",
	}) do

		local value = object:GetAttribute(attributeName)

		if value ~= nil then

			if containsWord(value, CONFIG.GUN_WORDS)
				or containsWord(value, {"sheriff", "hero"}) then

				return true

			end

		end

	end

	return false

end

--------------------------------------------------------
-- FIND PICKUP PROMPT
--------------------------------------------------------

local function findGunPickup()

	local localRoot = getRoot(LocalPlayer)

	if not localRoot then
		return nil
	end

	local closest = nil
	local closestDistance = CONFIG.MAX_GUN_DISTANCE

	for _, object in ipairs(Workspace:GetDescendants()) do

		------------------------------------------------
		-- TOOL
		------------------------------------------------

		if object:IsA("Tool") then

			if isPossibleGun(object) then

				local handle =
					object:FindFirstChild("Handle")
					or object:FindFirstChildWhichIsA("BasePart", true)

				if handle then

					local distance =
						(localRoot.Position - handle.Position).Magnitude

					if distance < closestDistance then

						local prompt =
							object:FindFirstChildWhichIsA(
								"ProximityPrompt",
								true
							)

						if prompt then

							closestDistance = distance

							closest = {

								Object = object,
								Prompt = prompt,
								Part = handle,

							}

						end

					end

				end

			end

		end

		------------------------------------------------
		-- PROMPT DIRECTLY ON PART/MODEL
		------------------------------------------------

		if object:IsA("ProximityPrompt") then

			local parent = object.Parent

			if parent then

				local model = parent

				local possibleName = model.Name

				if isPossibleGun(model)
					or containsWord(
						possibleName,
						CONFIG.DROP_WORDS
					) then

					local part =
						object.Parent:IsA("BasePart")
						and object.Parent
						or object.Parent:FindFirstChildWhichIsA(
							"BasePart",
							true
						)

					if part then

						local distance =
							(localRoot.Position - part.Position).Magnitude

						if distance < closestDistance then

							closestDistance = distance

							closest = {

								Object = model,
								Prompt = object,
								Part = part,

							}

						end

					end

				end

			end

		end

	end

	return closest

end

--------------------------------------------------------
-- LEGITIMATE AUTO PICKUP
--------------------------------------------------------

local function tryPickupGun()

	if AutoPickBusy then
		return
	end

	if not CONFIG.AUTO_PICK_ENABLED then
		return
	end

	AutoPickBusy = true

	local pickup = findGunPickup()

	if pickup and pickup.Prompt then

		local prompt = pickup.Prompt

		------------------------------------------------
		-- Only use an actual enabled game prompt.
		-- This does NOT create server ownership.
		------------------------------------------------

		if prompt.Enabled then

			pcall(function()

				prompt:InputHoldBegin()

				task.wait(
					math.max(
						prompt.HoldDuration,
						0.05
					)
				)

				prompt:InputHoldEnd()

			end)

		end

	end

	task.wait(0.25)

	AutoPickBusy = false

end


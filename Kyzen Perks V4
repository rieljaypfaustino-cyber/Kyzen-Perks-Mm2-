--------------------------------------------------------
-- UTILITY
--------------------------------------------------------

local function safeDestroy(object)

	if object then

		pcall(function()
			object:Destroy()
		end)

	end

end

--------------------------------------------------------

local function lower(value)

	return string.lower(tostring(value or ""))

end

--------------------------------------------------------

local function containsWord(text, words)

	text = lower(text)

	for _, word in ipairs(words) do

		if string.find(text, lower(word), 1, true) then
			return true
		end
	end

	return false

end

--------------------------------------------------------
-- CHARACTER
--------------------------------------------------------

local function getCharacter(player)

	return player.Character

end

--------------------------------------------------------

local function getRoot(player)

	local character = getCharacter(player)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")

end

--------------------------------------------------------
-- ATTRIBUTE ROLE
--------------------------------------------------------

local function getAttributeRole(player)

	for _, attributeName in ipairs(CONFIG.ROLE_ATTRIBUTES) do

		local value = player:GetAttribute(attributeName)

		if value ~= nil then

			local role = lower(value)

			if string.find(role, "murder") then
				return "Murderer"
			end

			if string.find(role, "sheriff") then
				return "Sheriff"
			end

			if string.find(role, "hero") then
				return "Hero"
			end

			if string.find(role, "innocent") then
				return "Innocent"
			end

		end

	end

	return nil

end

--------------------------------------------------------
-- FIND TOOLS
--------------------------------------------------------

local function getAllPlayerTools(player)

	local tools = {}

	local backpack = player:FindFirstChildOfClass("Backpack")

	if backpack then

		for _, object in ipairs(backpack:GetChildren()) do

			if object:IsA("Tool") then
				table.insert(tools, object)
			end

		end

	end

	local character = player.Character

	if character then

		for _, object in ipairs(character:GetChildren()) do

			if object:IsA("Tool") then
				table.insert(tools, object)
			end

		end

	end

	return tools

end

--------------------------------------------------------
-- DETECT KNIFE
--------------------------------------------------------

local function hasKnife(player)

	for _, tool in ipairs(getAllPlayerTools(player)) do

		if containsWord(tool.Name, CONFIG.KNIFE_WORDS) then
			return true
		end

		for _, descendant in ipairs(tool:GetDescendants()) do

			if descendant:IsA("StringValue") then

				if containsWord(descendant.Value, CONFIG.KNIFE_WORDS) then
					return true
				end

			end

		end

	end

	return false

end

--------------------------------------------------------
-- DETECT GUN
--------------------------------------------------------

local function hasGun(player)

	for _, tool in ipairs(getAllPlayerTools(player)) do

		if containsWord(tool.Name, CONFIG.GUN_WORDS) then
			return true
		end

		for _, descendant in ipairs(tool:GetDescendants()) do

			if descendant:IsA("StringValue") then

				if containsWord(descendant.Value, CONFIG.GUN_WORDS) then
					return true
				end

			end

		end

	end

	return false

end

--------------------------------------------------------
-- ROLE CACHE
--------------------------------------------------------

local PreviousRoles = {}

--------------------------------------------------------
-- ROLE DETECTION
--------------------------------------------------------

local function getRole(player)

	----------------------------------------------------
	-- SERVER ATTRIBUTE FIRST
	----------------------------------------------------

	local attributeRole = getAttributeRole(player)

	if attributeRole then

		PreviousRoles[player] = attributeRole

		return attributeRole

	end

	----------------------------------------------------
	-- KNIFE
	----------------------------------------------------

	if hasKnife(player) then

		PreviousRoles[player] = "Murderer"

		return "Murderer"

	end

	----------------------------------------------------
	-- GUN
	----------------------------------------------------

	if hasGun(player) then

		------------------------------------------------
		-- If previously Innocent and now has dropped
		-- Sheriff weapon, treat as Hero fallback.
		------------------------------------------------

		local previous = PreviousRoles[player]

		if previous == "Innocent" then

			PreviousRoles[player] = "Hero"

			return "Hero"

		end

		PreviousRoles[player] = "Sheriff"

		return "Sheriff"

	end

	----------------------------------------------------
	-- NO WEAPON
	----------------------------------------------------

	if not PreviousRoles[player] then
		PreviousRoles[player] = "Innocent"
	end

	return PreviousRoles[player]

end

--------------------------------------------------------
-- ROLE COLOR
--------------------------------------------------------

local function getRoleColor(role)

	if role == "Murderer" then
		return COLORS.Red
	end

	if role == "Sheriff" then
		return COLORS.Blue
	end

	if role == "Hero" then
		return COLORS.Yellow
	end

	return COLORS.Green

end

--------------------------------------------------------
-- REMOVE ESP
--------------------------------------------------------

local function removeESP(player)

	local data = ESPData[player]

	if not data then
		return
	end

	safeDestroy(data.Highlight)
	safeDestroy(data.Billboard)

	ESPData[player] = nil

end

--------------------------------------------------------
-- CREATE ESP
--------------------------------------------------------

local function createESP(player)

	if player == LocalPlayer then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local root = getRoot(player)

	if not root then
		return
	end

	removeESP(player)

	local role = getRole(player)

	local roleColor = getRoleColor(role)

	----------------------------------------------------
	-- HIGHLIGHT
	----------------------------------------------------

	local highlight = Instance.new("Highlight")

	highlight.Name = "KYZEN_ESP_Highlight"

	highlight.Adornee = character

	highlight.FillColor = roleColor
	highlight.OutlineColor = roleColor

	highlight.FillTransparency = 0.55
	highlight.OutlineTransparency = 0

	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

	highlight.Parent = character

	----------------------------------------------------
	-- BILLBOARD
	----------------------------------------------------

	local billboard = Instance.new("BillboardGui")

	billboard.Name = "KYZEN_ESP_Billboard"

	billboard.Adornee = root

	billboard.Size = UDim2.fromOffset(250, 65)

	billboard.StudsOffset = Vector3.new(0, 3.6, 0)

	billboard.AlwaysOnTop = true

	billboard.MaxDistance = 10000

	billboard.Parent = character

	----------------------------------------------------
	-- TEXT
	----------------------------------------------------

	local label = Instance.new("TextLabel")

	label.Name = "Info"

	label.Size = UDim2.fromScale(1, 1)

	label.BackgroundTransparency = 1

	label.TextColor3 = roleColor

	label.TextStrokeColor3 = COLORS.Black
	label.TextStrokeTransparency = 0

	label.Font = Enum.Font.GothamBold

	label.TextScaled = true

	label.Text = player.DisplayName .. "  [" .. player.Name .. "]\n" .. role

	label.Parent = billboard

	----------------------------------------------------
	-- DATA
	----------------------------------------------------

	ESPData[player] = {

		Highlight = highlight,
		Billboard = billboard,
		Label = label,

	}

end

--------------------------------------------------------
-- UPDATE ESP
--------------------------------------------------------

local function updateESP(player)

	if player == LocalPlayer then
		return
	end

	if not CONFIG.ESP_ENABLED then

		removeESP(player)

		return

	end

	local character = player.Character

	if not character then

		removeESP(player)

		return

	end

	local root = getRoot(player)

	if not root then

		removeESP(player)

		return

	end

	local role = getRole(player)

	local color = getRoleColor(role)

	local data = ESPData[player]

	if not data
		or not data.Highlight
		or not data.Billboard
		or not data.Label
		or data.Highlight.Parent ~= character then

		createESP(player)

		data = ESPData[player]

	end

	if not data then
		return
	end

	data.Highlight.FillColor = color
	data.Highlight.OutlineColor = color

	local distanceText = ""

	if CONFIG.SHOW_DISTANCE then

		local localRoot = getRoot(LocalPlayer)

		if localRoot then

			local distance =
				math.floor(
					(localRoot.Position - root.Position).Magnitude
				)

			distanceText = "\n" .. distance .. " studs"

		end

	end

	data.Label.Text =
		player.DisplayName
		.. "  ["
		.. player.Name
		.. "]\n"
		.. role
		.. distanceText

	data.Label.TextColor3 = color

end

--------------------------------------------------------
-- REMOVE EVERY ESP
--------------------------------------------------------

local function clearAllESP()

	for player in pairs(ESPData) do
		removeESP(player)
	end

end

--------------------------------------------------------
-- ROUND SIGNATURE
--------------------------------------------------------

local function getRoundSignature()

	local possibleNames = {

		"RoundId",
		"Round",
		"RoundNumber",
		"CurrentRound",
		"GameRound",

	}

	for _, name in ipairs(possibleNames) do

		local value = Workspace:GetAttribute(name)

		if value ~= nil then
			return tostring(name) .. ":" .. tostring(value)
		end

	end

	return nil

end

--------------------------------------------------------
-- ROUND CHECK
--------------------------------------------------------

local function checkRound()

	local signature = getRoundSignature()

	if signature and signature ~= CurrentRoundSignature then

		CurrentRoundSignature = signature

		PreviousRoles = {}

		clearAllESP()

	end

end


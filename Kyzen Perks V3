--------------------------------------------------------
-- ROLE NORMALIZATION
--------------------------------------------------------

local function normalizeRole(value)

	if value == nil then
		return nil
	end

	local text = string.lower(tostring(value))

	text = text:gsub("%s+", "")

	if text == "murderer"
		or text == "murder"
		or text == "killer" then

		return "Murderer"

	end

	if text == "sheriff" then
		return "Sheriff"
	end

	if text == "hero" then
		return "Hero"
	end

	if text == "innocent" then
		return "Innocent"
	end

	return nil

end

--------------------------------------------------------
-- TOOL DETECTION
--------------------------------------------------------

local function hasToolMatching(container, words)

	if not container then
		return false
	end

	for _, object in ipairs(container:GetChildren()) do

		if object:IsA("Tool") then

			local name = string.lower(object.Name)

			for _, word in ipairs(words) do

				if string.find(name, word, 1, true) then
					return true
				end

			end

		end

	end

	return false

end

local function playerHasKnife(player)

	local character = player.Character

	local backpack = player:FindFirstChildOfClass("Backpack")

	return
		hasToolMatching(character, KNIFE_WORDS)
		or hasToolMatching(backpack, KNIFE_WORDS)

end

local function playerHasGun(player)

	local character = player.Character

	local backpack = player:FindFirstChildOfClass("Backpack")

	return
		hasToolMatching(character, GUN_WORDS)
		or hasToolMatching(backpack, GUN_WORDS)

end

--------------------------------------------------------
-- SERVER ROLE FIRST
--------------------------------------------------------

local function getAttributeRole(player)

	for _, attributeName in ipairs(ROLE_ATTRIBUTE_NAMES) do

		local value = player:GetAttribute(attributeName)

		local role = normalizeRole(value)

		if role then
			return role
		end

	end

	return nil

end

--------------------------------------------------------
-- ROLE DETECTION
--------------------------------------------------------

local function getRole(player)

	if not player then
		return nil
	end

	----------------------------------------------------
	-- SERVER ROLE HAS PRIORITY
	----------------------------------------------------

	local serverRole = getAttributeRole(player)

	if serverRole then

		RoleCache[player] = serverRole

		return serverRole

	end

	----------------------------------------------------
	-- FALLBACK
	----------------------------------------------------

	if playerHasKnife(player) then

		RoleCache[player] = "Murderer"

		return "Murderer"

	end

	if playerHasGun(player) then

		RoleCache[player] = "Sheriff"

		return "Sheriff"

	end

	----------------------------------------------------
	-- DO NOT KEEP OLD ROLE FOREVER
	----------------------------------------------------

	RoleCache[player] = "Innocent"

	return "Innocent"

end

--------------------------------------------------------
-- CHARACTER ROOT
--------------------------------------------------------

local function getRoot(character)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")

end

--------------------------------------------------------
-- DESTROY ONE ESP
--------------------------------------------------------

local function removeESP(player)

	local data = ESPData[player]

	if not data then
		return
	end

	if data.Highlight then
		destroy(data.Highlight)
	end

	if data.Billboard then
		destroy(data.Billboard)
	end

	ESPData[player] = nil

end

--------------------------------------------------------
-- DESTROY ALL ESP
--------------------------------------------------------

local function removeAllESP()

	for player in pairs(ESPData) do
		removeESP(player)
	end

end

--------------------------------------------------------
-- CREATE ESP
--------------------------------------------------------

local function createESP(player)

	if player == LocalPlayer then
		return
	end

	if not ESPEnabled then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	local root = getRoot(character)

	if not humanoid or not root then
		return
	end

	----------------------------------------------------
	-- ABSOLUTE DUPLICATE PROTECTION
	----------------------------------------------------

	removeESP(player)

	local role = getRole(player)

	local roleColor = ROLE_COLORS[role] or COLORS.Green

	----------------------------------------------------
	-- HIGHLIGHT
	----------------------------------------------------

	local highlight = Instance.new("Highlight")

	highlight.Name = "KYZEN_ESP"

	highlight.Adornee = character

	highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop

	highlight.FillColor = roleColor

	highlight.OutlineColor = roleColor

	highlight.FillTransparency = 0.78

	highlight.OutlineTransparency = 0

	highlight.Parent = character

	----------------------------------------------------
	-- BILLBOARD
	----------------------------------------------------

	local billboard = Instance.new("BillboardGui")

	billboard.Name = "KYZEN_ESP_TEXT"

	billboard.Adornee = root

	billboard.Size = UDim2.fromOffset(250, 55)

	billboard.StudsOffset = Vector3.new(0, 3.25, 0)

	billboard.AlwaysOnTop = true

	billboard.LightInfluence = 0

	billboard.MaxDistance = 10000

	billboard.Parent = root

	local text = Instance.new("TextLabel")

	text.Name = "PlayerInfo"

	text.BackgroundTransparency = 1

	text.Size = UDim2.fromScale(1, 1)

	text.Font = Enum.Font.GothamBold

	text.TextSize = 14

	text.TextColor3 = roleColor

	text.TextStrokeColor3 = Color3.new(0, 0, 0)

	text.TextStrokeTransparency = 0

	text.TextWrapped = true

	text.Text = player.DisplayName .. "  •  " .. role

	text.Parent = billboard

	----------------------------------------------------
	-- SAVE
	----------------------------------------------------

	ESPData[player] = {
		Highlight = highlight,
		Billboard = billboard,
		Text = text,
		Character = character,
		Role = role,
	}

end

--------------------------------------------------------
-- REFRESH ESP
--------------------------------------------------------

local function refreshESP(player)

	if player == LocalPlayer then
		return
	end

	if not ESPEnabled then

		removeESP(player)

		return

	end

	local character = player.Character

	if not character then

		removeESP(player)

		return

	end

	local role = getRole(player)

	local old = ESPData[player]

	----------------------------------------------------
	-- CHARACTER CHANGED
	----------------------------------------------------

	if not old
		or old.Character ~= character
		or not old.Highlight
		or not old.Highlight.Parent
		or not old.Billboard
		or not old.Billboard.Parent then

		createESP(player)

		return

	end

	----------------------------------------------------
	-- ROLE CHANGED
	----------------------------------------------------

	if old.Role ~= role then

		createESP(player)

		return

	end

	----------------------------------------------------
	-- UPDATE COLOR
	----------------------------------------------------

	local color = ROLE_COLORS[role] or COLORS.Green

	old.Highlight.FillColor = color
	old.Highlight.OutlineColor = color

	old.Text.TextColor3 = color

end

--------------------------------------------------------
-- DISTANCE UPDATE
--------------------------------------------------------

local function updateDistances()

	if not ESPEnabled then
		return
	end

	local myCharacter = LocalPlayer.Character

	local myRoot = getRoot(myCharacter)

	if not myRoot then
		return
	end

	for player, data in pairs(ESPData) do

		if player.Parent ~= Players then

			removeESP(player)

			continue

		end

		local character = player.Character

		if not character or character ~= data.Character then

			refreshESP(player)

			continue

		end

		local root = getRoot(character)

		if not root then
			continue
		end

		local role = getRole(player)

		local color = ROLE_COLORS[role] or COLORS.Green

		data.Role = role

		data.Highlight.FillColor = color
		data.Highlight.OutlineColor = color
		data.Text.TextColor3 = color

		local distance =
			math.floor(
				(myRoot.Position - root.Position).Magnitude
			)

		data.Text.Text =
			player.DisplayName
			.. "\n"
			.. role
			.. "  •  "
			.. distance
			.. " studs"

	end

end

--------------------------------------------------------
-- ROUND DETECTION
--------------------------------------------------------

local function getRoundState()

	local attributes = {
		"RoundId",
		"Round",
		"RoundNumber",
		"CurrentRound",
		"GameRound",
	}

	for _, attribute in ipairs(attributes) do

		local value = Players:GetAttribute(attribute)

		if value ~= nil then
			return tostring(value)
		end

		value = Workspace:GetAttribute(attribute)

		if value ~= nil then
			return tostring(value)
		end

	end

	return nil

end

local function resetRoundState()

	table.clear(RoleCache)

	removeAllESP()

	task.delay(0.15, function()

		if Destroyed then
			return
		end

		for _, player in ipairs(Players:GetPlayers()) do

			if player ~= LocalPlayer then
				refreshESP(player)
			end

		end

	end)

end

local function checkRound()

	local state = getRoundState()

	if not state then
		return
	end

	if LastRoundState == nil then

		LastRoundState = state

		return

	end

	if LastRoundState ~= state then

		LastRoundState = state

		resetRoundState()

	end

end

--------------------------------------------------------
-- PLAYER CONNECTIONS
--------------------------------------------------------

local function disconnectPlayer(player)

	if Connections[player] then

		for _, connection in ipairs(Connections[player]) do

			if connection and connection.Connected then
				connection:Disconnect()
			end

		end

	end

	Connections[player] = nil

end

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	disconnectPlayer(player)

	Connections[player] = {}

	----------------------------------------------------
	-- RESPAWN
	----------------------------------------------------

	table.insert(
		Connections[player],
		player.CharacterAdded:Connect(function()

			removeESP(player)

			RoleCache[player] = nil

			task.wait(0.08)

			if player.Parent == Players then
				refreshESP(player)
			end

		end)
	)

	----------------------------------------------------
	-- DEATH / CHARACTER REMOVING
	----------------------------------------------------

	table.insert(
		Connections[player],
		player.CharacterRemoving:Connect(function()

			removeESP(player)

		end)
	)

	----------------------------------------------------
	-- ROLE ATTRIBUTES
	----------------------------------------------------

	for _, attributeName in ipairs(ROLE_ATTRIBUTE_NAMES) do

		table.insert(
			Connections[player],
			player:GetAttributeChangedSignal(attributeName):Connect(function()

				RoleCache[player] = nil

				task.defer(function()

					if player.Parent == Players then
						refreshESP(player)
					end

				end)

			end)
		)

	end

	task.defer(function()

		if player.Parent == Players then
			refreshESP(player)
		end

	end)

end

for _, player in ipairs(Players:GetPlayers()) do

	if player ~= LocalPlayer then
		setupPlayer(player)
	end

end

Players.PlayerAdded:Connect(function(player)

	setupPlayer(player)

end)

Players.PlayerRemoving:Connect(function(player)

	removeESP(player)

	disconnectPlayer(player)

	RoleCache[player] = nil

end)


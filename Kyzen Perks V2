--------------------------------------------------------
-- BUILD ESP
--------------------------------------------------------

local function buildPlayerESP(player)

	if player == LocalPlayer then
		return
	end

	destroyPlayerESP(player)

	if not ESPEnabled then
		return
	end

	local character = player.Character

	if not character then
		return
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid")

	if not humanoid then
		return
	end

	----------------------------------------------------
	-- ALWAYS GET FRESH ROLE
	----------------------------------------------------

	local role = getServerRole(player)

	RoleCache[player] = role

	local highlight = createHighlight(character, role)

	local billboard, label = createBillboard(player, character)

	if not highlight or not billboard then
		return
	end

	ESPObjects[player] = {

		Highlight = highlight,

		Billboard = billboard,

		Label = label,

		Character = character,

		Role = role,

	}

end

--------------------------------------------------------
-- REFRESH ONE PLAYER
--------------------------------------------------------

local function refreshPlayerESP(player)

	if player == LocalPlayer then
		return
	end

	if not ESPEnabled then

		destroyPlayerESP(player)

		return
	end

	local character = player.Character

	if not character then

		destroyPlayerESP(player)

		return
	end

	local data = ESPObjects[player]

	local currentRole = getServerRole(player)

	RoleCache[player] = currentRole

	----------------------------------------------------
	-- CHARACTER CHANGED
	----------------------------------------------------

	if not data
		or data.Character ~= character
		or not data.Highlight
		or not data.Highlight.Parent
		or not data.Billboard
		or not data.Billboard.Parent then

		buildPlayerESP(player)

		return
	end

	----------------------------------------------------
	-- ROLE CHANGED
	----------------------------------------------------

	if data.Role ~= currentRole then

		buildPlayerESP(player)

		return
	end

	----------------------------------------------------
	-- FORCE COLOR UPDATE
	----------------------------------------------------

	local color = getRoleColor(currentRole)

	data.Highlight.FillColor = color
	data.Highlight.OutlineColor = color

	data.Label.TextColor3 = color

end

--------------------------------------------------------
-- DISTANCE UPDATE
--------------------------------------------------------

local function updateDistances()

	if not ESPEnabled then
		return
	end

	local localCharacter = LocalPlayer.Character

	local localRoot = getRoot(localCharacter)

	if not localRoot then
		return
	end

	for player, data in pairs(ESPObjects) do

		if player.Parent ~= Players then

			destroyPlayerESP(player)

			continue
		end

		local character = player.Character

		if not character or character ~= data.Character then

			refreshPlayerESP(player)

			continue
		end

		local root = getRoot(character)

		if not root then
			continue
		end

		local distance = (localRoot.Position - root.Position).Magnitude

		local role = getServerRole(player)

		data.Role = role

		local color = getRoleColor(role)

		data.Highlight.FillColor = color
		data.Highlight.OutlineColor = color

		data.Label.TextColor3 = color

		data.Label.Text =
			player.DisplayName
			.. "\n"
			.. role
			.. "  •  "
			.. math.floor(distance)
			.. " studs"

	end

end

--------------------------------------------------------
-- ROUND ID
--------------------------------------------------------

local function getRoundId()

	for _, attributeName in ipairs(CONFIG.RoundAttributes) do

		local value = Players:GetAttribute(attributeName)

		if value ~= nil then
			return tostring(value)
		end

	end

	for _, attributeName in ipairs(CONFIG.RoundAttributes) do

		local value = Workspace:GetAttribute(attributeName)

		if value ~= nil then
			return tostring(value)
		end

	end

	return nil
end

--------------------------------------------------------
-- ROUND RESET CHECK
--------------------------------------------------------

local function checkRoundReset()

	local roundId = getRoundId()

	if roundId == nil then
		return
	end

	if LastRoundId == nil then

		LastRoundId = roundId

		return
	end

	if LastRoundId ~= roundId then

		LastRoundId = roundId

		------------------------------------------------
		-- CLEAR EVERYTHING FROM PREVIOUS ROUND
		------------------------------------------------

		table.clear(RoleCache)

		destroyAllESP()

		------------------------------------------------
		-- REBUILD FRESH
		------------------------------------------------

		task.delay(0.15, function()

			if destroying then
				return
			end

			for _, player in ipairs(Players:GetPlayers()) do

				if player ~= LocalPlayer then
					refreshPlayerESP(player)
				end

			end

		end)

	end

end

--------------------------------------------------------
-- PLAYER EVENT CONNECTIONS
--------------------------------------------------------

local function disconnectPlayer(player)

	local connections = PlayerConnections[player]

	if not connections then
		return
	end

	for _, connection in ipairs(connections) do

		if connection and connection.Connected then
			connection:Disconnect()
		end

	end

	PlayerConnections[player] = nil

end

local function setupPlayer(player)

	if player == LocalPlayer then
		return
	end

	disconnectPlayer(player)

	PlayerConnections[player] = {}

	local connections = PlayerConnections[player]

	----------------------------------------------------
	-- CHARACTER ADDED
	----------------------------------------------------

	table.insert(
		connections,
		player.CharacterAdded:Connect(function(character)

			destroyPlayerESP(player)

			RoleCache[player] = nil

			task.wait(0.05)

			if character.Parent then
				refreshPlayerESP(player)
			end

		end)
	)

	----------------------------------------------------
	-- CHARACTER REMOVING
	----------------------------------------------------

	table.insert(
		connections,
		player.CharacterRemoving:Connect(function()

			destroyPlayerESP(player)

			RoleCache[player] = nil

		end)
	)

	----------------------------------------------------
	-- ROLE ATTRIBUTE CHANGED
	----------------------------------------------------

	table.insert(
		connections,
		player:GetAttributeChangedSignal(CONFIG.RoleAttribute):Connect(function()

			RoleCache[player] = nil

			task.defer(function()

				if player.Parent == Players then
					refreshPlayerESP(player)
				end

			end)

		end)
	)

	----------------------------------------------------
	-- EXTRA ROLE ATTRIBUTES
	----------------------------------------------------

	for _, attributeName in ipairs({
		"PlayerRole",
		"CurrentRole",
		"RoleName",
	}) do

		table.insert(
			connections,
			player:GetAttributeChangedSignal(attributeName):Connect(function()

				RoleCache[player] = nil

				task.defer(function()

					if player.Parent == Players then
						refreshPlayerESP(player)
					end

				end)

			end)
		)

	end

	----------------------------------------------------
	-- INITIAL
	----------------------------------------------------

	task.defer(function()

		if player.Parent == Players then
			refreshPlayerESP(player)
		end

	end)

end

--------------------------------------------------------
-- PLAYER ADDED
--------------------------------------------------------

Players.PlayerAdded:Connect(function(player)


local function safeDestroy(instance)

	if instance and instance.Parent then
		instance:Destroy()
	end

end

--------------------------------------------------------
-- ROLE NORMALIZER
--------------------------------------------------------

local function normalizeRole(value)

	if value == nil then
		return nil
	end

	local role = tostring(value)

	role = role:gsub("%s+", "")
	role = role:lower()

	if role == "innocent" then
		return "Innocent"
	end

	if role == "murderer" then
		return "Murderer"
	end

	if role == "murder" then
		return "Murderer"
	end

	if role == "killer" then
		return "Murderer"
	end

	if role == "sheriff" then
		return "Sheriff"
	end

	if role == "hero" then
		return "Hero"
	end

	return nil
end

--------------------------------------------------------
-- TOOL SEARCH
--------------------------------------------------------

local function containsWord(name, words)

	name = string.lower(name)

	for _, word in ipairs(words) do

		if string.find(name, string.lower(word), 1, true) then
			return true
		end

	end

	return false
end

local function characterHasTool(character, words)

	if not character then
		return false
	end

	for _, object in ipairs(character:GetChildren()) do

		if object:IsA("Tool") then

			if containsWord(object.Name, words) then
				return true
			end

		end

	end

	return false
end

local function backpackHasTool(player, words)

	local backpack = player:FindFirstChildOfClass("Backpack")

	if not backpack then
		return false
	end

	for _, object in ipairs(backpack:GetChildren()) do

		if object:IsA("Tool") then

			if containsWord(object.Name, words) then
				return true
			end

		end

	end

	return false
end

--------------------------------------------------------
-- ROLE DETECTION
--------------------------------------------------------

local function getServerRole(player)

	if not player then
		return nil
	end

	----------------------------------------------------
	-- PRIMARY SOURCE
	----------------------------------------------------

	local attributeRole = player:GetAttribute(CONFIG.RoleAttribute)

	local normalized = normalizeRole(attributeRole)

	if normalized then
		return normalized
	end

	----------------------------------------------------
	-- OPTIONAL OTHER COMMON ATTRIBUTES
	----------------------------------------------------

	local alternateAttributes = {
		"PlayerRole",
		"CurrentRole",
		"RoleName",
	}

	for _, attributeName in ipairs(alternateAttributes) do

		local value = player:GetAttribute(attributeName)

		local role = normalizeRole(value)

		if role then
			return role
		end

	end

	----------------------------------------------------
	-- FALLBACK TOOL DETECTION
	----------------------------------------------------

	local character = player.Character

	local hasKnife =
		characterHasTool(character, CONFIG.KnifeWords)
		or backpackHasTool(player, CONFIG.KnifeWords)

	local hasGun =
		characterHasTool(character, CONFIG.GunWords)
		or backpackHasTool(player, CONFIG.GunWords)

	if hasKnife then
		return "Murderer"
	end

	if hasGun then
		return "Sheriff"
	end

	----------------------------------------------------
	-- IMPORTANT:
	-- Do not randomly keep old Hero/Sheriff/Murderer.
	----------------------------------------------------

	return "Innocent"
end

--------------------------------------------------------
-- ROLE COLOR
--------------------------------------------------------

local function getRoleColor(role)

	return CONFIG.RoleColors[role]
		or CONFIG.RoleColors.Innocent

end

--------------------------------------------------------
-- CHARACTER ROOT
--------------------------------------------------------

local function getRoot(character)

	if not character then
		return nil
	end

	return character:FindFirstChild("HumanoidRootPart")
		or character:FindFirstChild("UpperTorso")
		or character:FindFirstChild("Torso")

end

--------------------------------------------------------
-- ESP CLEANUP
--------------------------------------------------------

local function destroyPlayerESP(player)

	local data = ESPObjects[player]

	if not data then
		return
	end

	if data.Highlight then
		safeDestroy(data.Highlight)
	end

	if data.Billboard then
		safeDestroy(data.Billboard)
	end

	ESPObjects[player] = nil

end

local function destroyAllESP()

	for player in pairs(ESPObjects) do
		destroyPlayerESP(player)
	end

end


-- AUTOPICK GUN
--------------------------------------------------------

local function isGunTool(tool)

	if not tool or not tool:IsA("Tool") then
		return false
	end

	return containsWord(tool.Name, CONFIG.HeroGunWords)

end

local function getPromptFromTool(tool)

	if not tool then
		return nil
	end

	for _, object in ipairs(tool:GetDescendants()) do

		if object:IsA("ProximityPrompt") then
			return object
		end

	end

	return nil

end

local function findDroppedGun()

	local character = LocalPlayer.Character

	local localRoot = getRoot(character)

	if not localRoot then
		return nil
	end

	local closestTool = nil

	local closestDistance = CONFIG.GunSearchRadius

	for _, object in ipairs(Workspace:GetDescendants()) do

		if object:IsA("Tool") and isGunTool(object) then

			------------------------------------------------
			-- Don't select equipped tools.
			------------------------------------------------

			local parent = object.Parent

			if parent == Workspace
				or (parent and parent:IsA("Model") and parent ~= character) then

				local handle = object:FindFirstChild("Handle")

				if handle and handle:IsA("BasePart") then

					local distance =
						(localRoot.Position - handle.Position).Magnitude

					if distance <= closestDistance then

						closestDistance = distance

						closestTool = object

					end

				end

			end

		end

	end

	return closestTool

end

local function attemptPickupGun()

	if not AutoPickEnabled then
		return
	end

	----------------------------------------------------
	-- Don't try if already holding a weapon.
	----------------------------------------------------

	local currentRole = getServerRole(LocalPlayer)

	if currentRole == "Sheriff" or currentRole == "Hero" then
		return
	end

	local gun = findDroppedGun()

	if not gun then
		return
	end

	local prompt = getPromptFromTool(gun)

	if not prompt then
		return
	end

	----------------------------------------------------
	-- Legitimate Roblox ProximityPrompt interaction.
	-- The server must handle the actual pickup.
	----------------------------------------------------

	if prompt.Enabled then

		pcall(function()

			prompt:InputHoldBegin()

			task.wait(math.max(prompt.HoldDuration, 0.05))

			prompt:InputHoldEnd()

		end)

	end

end

